@model About
@{ViewData["Title"]=L["About"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
<section class="luxe-page-hero luxe-about-hero"><div class="container"><span class="luxe-eyebrow">@(en?"THE XSPA STORY":"XSPA HİKÂYESİ")</span><h1 class="luxe-title">@(en?"Care, in every":"Her detayında")<br /><em>@(en?"little detail.":"özen var.")</em></h1><p class="luxe-lead">@(en?"A considered approach to feeling good. A little less hurry, a little more you.":"İyi hissetmeye özenli bir yaklaşım. Biraz daha az telaş, biraz daha çok siz.")</p></div></section><section class="luxe-section luxe-about-story"><div class="container luxe-story"><div class="luxe-story-media" data-aos="fade-up"><img src="@Media.Image(Model?.Image,"img/about-retreat.webp")" alt="@(en?"The calm of a spa retreat":"Spa dünyasının dinginliği")" width="1200" height="1200" /></div><div class="luxe-story-text" data-aos="fade-up"><span class="luxe-eyebrow">@(en?"OUR PHILOSOPHY":"FELSEFEMİZ")</span><h2>@(string.IsNullOrWhiteSpace(Model?.Title)?"Spa & Wellness":Model.Title)</h2><div class="luxe-prose">@Html.Raw(SafeHtml.Sanitize(Model?.Content))</div><div class="luxe-signature">@(en?"Wellbeing, at your own pace.":"İyi yaşam, sizin ritminizde.")</div><a class="luxe-text-link" asp-controller="Service" asp-action="Index">@(en?"Discover our rituals":"Ritüellerimizi keşfedin") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></div></section><section class="luxe-section luxe-section-light"><div class="container"><div class="luxe-section-heading"><div><span class="luxe-eyebrow">@(en?"WHAT WE CARE ABOUT":"ÖNEMSEDİKLERİMİZ")</span><h2>@(en?"The difference is in the details.":"Fark, küçük detaylarda.")</h2></div></div><div class="row g-4"><div class="col-md-6"><div class="luxe-hours h-100"><i class="fa-solid fa-spa text-success mb-3" aria-hidden="true"></i><h3>@Model?.CardTitle1</h3><p>@Model?.CardContent1</p></div></div><div class="col-md-6"><div class="luxe-hours h-100"><i class="fa-solid fa-leaf text-success mb-3" aria-hidden="true"></i><h3>@Model?.CardTitle2</h3><p>@Model?.CardContent2</p></div></div><div class="col-md-6"><div class="luxe-hours h-100"><i class="fa-solid fa-leaf text-success mb-3" aria-hidden="true"></i><h3>@(en ? "A Personal Programme" : "Kişiye Özel Program")</h3><p>@(en ? "A ritual designed from scratch for every guest." : "Her misafir için sıfırdan tasarlanan ritüel.")</p></div></div><div class="col-md-6"><div class="luxe-hours h-100"><i class="fa-solid fa-lock text-success mb-3" aria-hidden="true"></i><h3>@(en ? "Privacy & Comfort" : "Gizlilik & Konfor")</h3><p>@(en ? "Private spaces reserved just for you." : "Yalnızca size ayrılmış özel alanlar.")</p></div></div></div></div></section>
