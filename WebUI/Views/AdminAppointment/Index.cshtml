@model BusinessLayer.Dtos.PaginatedList<BusinessLayer.Dtos.AppointmentAdminDto>
@using EntityLayer.Enum
@{
    ViewData["Title"] = "Randevu Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = ViewData["StatusFilter"] as AppointmentStatus?;
}
<div class="card border-0 shadow-sm appointment-admin">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div><span class="text-uppercase small text-muted">XSPA · Concierge</span><h4 class="mt-2 mb-1">Randevu Yönetimi</h4><p class="mb-0 text-muted">@Model.TotalCount talep · Tarih ve saatler Türkiye saatidir.</p></div>
        <div class="d-flex flex-wrap gap-2" aria-label="Randevu durum filtreleri">
            <a asp-action="Index" class="btn @(filter is null ? "btn-primary" : "btn-outline-secondary")">Tümü</a>
            <a asp-action="Index" asp-route-status="Pending" class="btn @(filter == AppointmentStatus.Pending ? "btn-primary" : "btn-outline-secondary")">Bekleyen</a>
            <a asp-action="Index" asp-route-status="Confirmed" class="btn @(filter == AppointmentStatus.Confirmed ? "btn-primary" : "btn-outline-secondary")">Onaylanan</a>
            <a asp-action="Index" asp-route-status="Cancelled" class="btn @(filter == AppointmentStatus.Cancelled ? "btn-primary" : "btn-outline-secondary")">İptal edilen</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["AppointmentSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["AppointmentError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
        @if (Model.Items.Count == 0) { <div class="text-center p-5 text-muted">Bu görünümde randevu talebi bulunmuyor.</div> }
        else
        {
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>Referans / Hizmet</th><th>Misafir / İletişim</th><th>Tarih / Saat</th><th>Misafir Notu</th><th>Durum / İşlemler</th></tr></thead>
                <tbody>
                @foreach (var appointment in Model.Items)
                {
                    var label = appointment.Status switch { AppointmentStatus.Confirmed => "Onaylandı", AppointmentStatus.Cancelled => "İptal edildi", _ => "Onay bekliyor" };
                    var color = appointment.Status switch { AppointmentStatus.Confirmed => "success", AppointmentStatus.Cancelled => "secondary", _ => "warning" };
                    var phone = new string(appointment.Phone.Where(character => char.IsDigit(character) || character == '+').ToArray());
                    <tr>
                        <td><strong>@appointment.ReferenceCode</strong><div class="mt-1">@appointment.ServiceTitle</div>@if(!string.IsNullOrWhiteSpace(appointment.GiftCode)){<small>VIP: @appointment.GiftCode</small>}<small class="text-muted">@appointment.GuestCount misafir</small></td>
                        <td><strong>@appointment.FullName</strong><div><a href="tel:@phone">@appointment.Phone</a></div><div>@appointment.Email</div></td>
                        <td class="text-nowrap">@appointment.AppointmentDate.ToString("dd.MM.yyyy")<br /><strong>@appointment.TimeSlot</strong></td>
                        <td style="min-width:180px;max-width:320px;white-space:pre-wrap;overflow-wrap:anywhere">@(string.IsNullOrWhiteSpace(appointment.Notes) ? "—" : appointment.Notes)</td>
                        <td><span class="badge bg-label-@color">@label</span><div class="d-flex flex-wrap gap-2 mt-3">
                        @if (appointment.Status == AppointmentStatus.Pending)
                        {
                            <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@appointment.Id" /><button class="btn btn-sm btn-success" type="submit">Onayla</button></form>
                        }
                        @if (appointment.Status != AppointmentStatus.Cancelled)
                        {
                            <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@appointment.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">İptal Et</button></form>
                        }
                        </div></td>
                    </tr>
                }
                </tbody>
            </table></div>
            <nav class="d-flex justify-content-between align-items-center mt-4" aria-label="Randevu sayfaları">
                <div>@if (Model.HasPreviousPage) { <a asp-action="Index" asp-route-status="@filter" asp-route-page="@(Model.PageIndex - 1)" class="btn btn-outline-secondary">Önceki</a> }</div>
                <span>Sayfa @Model.PageIndex / @Math.Max(1, Model.TotalPages)</span>
                <div>@if (Model.HasNextPage) { <a asp-action="Index" asp-route-status="@filter" asp-route-page="@(Model.PageIndex + 1)" class="btn btn-outline-secondary">Sonraki</a> }</div>
            </nav>
        }
    </div>
</div>
