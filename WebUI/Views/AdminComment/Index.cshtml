@model BusinessLayer.Dtos.PaginatedList<BusinessLayer.Dtos.PendingCommentDto>
@{ ViewData["Title"]=L["PendingComments"];Layout="~/Views/Shared/_AdminLayout.cshtml"; }
<div class="card p-4">
<h5>@L["PendingComments"] (@Model.TotalCount)</h5>
@if(TempData["CommentError"] is string error){<p class="text-danger">@error</p>}
<table class="table"><thead><tr><th>Blog ID</th><th>@L["Author"]</th><th>@L["YourComment"]</th><th>@L["DateUtc"]</th><th>@L["Actions"]</th></tr></thead><tbody>
@foreach(var comment in Model.Items)
{
<tr><td>@comment.BlogId</td><td>@comment.AuthorName</td><td style="white-space:pre-wrap">@comment.Content</td><td>@comment.CreatedDate</td><td>
<form asp-action="Approve" method="post"><input type="hidden" name="id" value="@comment.Id"/><button class="btn btn-success">@L["Approve"]</button></form>
<form asp-action="Delete" method="post"><input type="hidden" name="id" value="@comment.Id"/><button class="btn btn-danger">@L["RejectDelete"]</button></form>
</td></tr>
}
</tbody></table>
<nav>
@if(Model.HasPreviousPage){<a asp-action="Index" asp-route-page="@(Model.PageIndex-1)">@L["Previous"]</a>}
<span>@L["Page"] @Model.PageIndex / @Math.Max(1,Model.TotalPages)</span>
@if(Model.HasNextPage){<a asp-action="Index" asp-route-page="@(Model.PageIndex+1)">@L["Next"]</a>}
</nav></div>
