@{ var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US"; }
<section class="legal-hero"><div class="container"><span class="luxe-eyebrow">XSPA · SPA &amp; WELLNESS</span><h1>@ViewData["Title"]</h1><p>@(en ? "Clarity, care and trust." : "Şeffaflık, özen ve güven.")</p></div></section><article class="legal-content container">
<section><h2>@(en ? "Requests and confirmation" : "Randevu talebi ve onay")</h2><p>@(en ? "The online form creates a request. Dates and times become confirmed when our team verifies availability and approves the booking. A request or WhatsApp thank-you screen alone does not confirm a reservation." : "Online form bir ön talep oluşturur. Tarih ve saat, ekibimiz uygunluğu doğrulayıp onay verdiğinde kesinleşir. Talep veya WhatsApp teşekkür ekranı tek başına kesin rezervasyon değildir.")</p></section>
<section><h2>@(en ? "Changes and cancellation" : "Değişiklik ve iptal")</h2><p>@(en ? "If your plans change, contact us as early as possible with your booking reference. Any package-specific payment or cancellation conditions are communicated before booking." : "Planınız değişirse rezervasyon kodunuzla mümkün olan en kısa sürede bize ulaşın. Uygulanabilecek özel paket ve ödeme koşulları rezervasyon öncesinde ayrıca bildirilir.")</p></section>
<section><h2>@(en ? "Comfort and facility use" : "Konfor ve tesis kullanımı")</h2><p>@(en ? "Allow time to prepare before your appointment. Respect hygiene rules, shared spaces and other guests’ privacy. Services do not replace medical diagnosis or treatment." : "Randevunuzdan önce hazırlık için zaman ayırın. Hijyen kurallarına, ortak alanlara ve diğer misafirlerin mahremiyetine saygı gösterin. Hizmetler tıbbi tanı ya da tedavi yerine geçmez.")</p></section>
<section><h2>@(en ? "Information and contact" : "Bilgiler ve iletişim")</h2><p>@(en ? "Service descriptions and displayed prices provide information. Confirm current scope and availability with our team. Please use our contact page for questions." : "Hizmet açıklamaları ve mevcut fiyatlar bilgilendirme amaçlıdır. Güncel kapsamı ve uygunluğu ekibimizle teyit edin. Sorularınız için iletişim sayfamızı kullanın.")</p></section>
<a class="luxe-text-link" href="/iletisim">@(en ? "Contact our team" : "Ekibimize ulaşın") →</a></article>
