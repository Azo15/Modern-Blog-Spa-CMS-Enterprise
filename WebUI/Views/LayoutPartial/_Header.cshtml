@{var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US";}
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#081C15" />
<script>
    (() => { let theme = 'light'; try { const saved = localStorage.getItem('xspa-theme'); if (saved === 'dark' || saved === 'light') theme = saved; } catch { } document.documentElement.dataset.theme = theme; document.documentElement.classList.add('js-boot'); setTimeout(() => document.documentElement.classList.remove('js-boot'), 1200); })();
</script>
<title>@ViewData["Title"] · XSPA — Spa &amp; Wellness</title>
<meta name="description" content="@(ViewData["Description"] ?? (en ? "An unhurried spa experience. Discover massage, traditional hammam and wellbeing in Kırklareli." : "Kırklareli'de dingin bir spa deneyimi. Masaj, geleneksel hamam ve kendinize ayırdığınız özel anları keşfedin."))" />
@await Html.PartialAsync("_BrandIcons")
<link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
<link rel="stylesheet" href="~/lib/aos/aos.css" />
<link rel="stylesheet" href="~/lib/swipper/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/lib/fancybox/css/fancybox.min.css" />
<link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/navbar-account.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home-statistics.css" asp-append-version="true" />
