@model WebUI.Models.BlogPostViewModel
@using BusinessLayer.Security
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService CommentAuthorization
@{var canComment=(await CommentAuthorization.AuthorizeAsync(User,null,AccessPolicies.Member)).Succeeded;}
<section id="comments" class="container py-4">
<h2>Yorumlar (@Model.Comments.TotalCount ana yorum)</h2>
@if(TempData["CommentError"] is string error){<p class="text-danger">@error</p>}
@if(TempData["CommentSuccess"] is string success){<p class="text-success">@success</p>}
@foreach(var thread in Model.Comments.Items)
{
<article class="border-bottom py-3">
<strong>@thread.Comment.AuthorName</strong> <time>@thread.Comment.CreatedDate.ToString("dd.MM.yyyy HH:mm") UTC</time>
<p style="white-space:pre-wrap">@thread.Comment.Content</p>
@foreach(var reply in thread.Children)
{
<div class="ms-4 border-start ps-3"><strong>@reply.AuthorName</strong><time> @reply.CreatedDate.ToString("dd.MM.yyyy HH:mm") UTC</time><p style="white-space:pre-wrap">@reply.Content</p></div>
}
@if(canComment)
{
<details><summary>Yanıtla</summary>
<form asp-controller="Comment" asp-action="Create" method="post">
<input type="hidden" name="blogId" value="@Model.Blog.Id"/><input type="hidden" name="parentCommentId" value="@thread.Comment.Id"/><input type="hidden" name="slug" value="@Model.Blog.Slug"/>
<label for="reply-@thread.Comment.Id">Yanıtınız</label><textarea id="reply-@thread.Comment.Id" name="content" required maxlength="1000" class="form-control"></textarea>
<button class="btn btn-primary mt-2">Yanıtı gönder</button></form></details>
}
</article>
}
<nav class="my-3">
@if(Model.Comments.HasPreviousPage){<a asp-action="Post" asp-route-slug="@Model.Blog.Slug" asp-route-commentPage="@(Model.Comments.PageIndex-1)" asp-fragment="comments">Önceki yorumlar</a>}
@if(Model.Comments.HasNextPage){<a asp-action="Post" asp-route-slug="@Model.Blog.Slug" asp-route-commentPage="@(Model.Comments.PageIndex+1)" asp-fragment="comments">Sonraki yorumlar</a>}
</nav>
@if(canComment)
{
<h3>Yorum ekle</h3><p>Yorumlar moderatör onayından sonra görünür. Yanıtlar ana yorumun altına eklenir.</p>
<form asp-controller="Comment" asp-action="Create" method="post">
<input type="hidden" name="blogId" value="@Model.Blog.Id"/><input type="hidden" name="slug" value="@Model.Blog.Slug"/>
<label for="new-comment">Yorumunuz</label><textarea id="new-comment" name="content" required maxlength="1000" class="form-control"></textarea>
<button class="btn btn-primary mt-2">Onaya gönder</button></form>
@if(Model.OwnComments.Any())
{
<h3 class="mt-4">Son yorumlarım</h3>
@foreach(var own in Model.OwnComments)
{
<details class="my-2"><summary>Yorum #@own.Id — @(own.IsApproved ? "Onaylı" : "Onay bekliyor")</summary>
<form asp-controller="Comment" asp-action="Update" method="post">
<input type="hidden" name="id" value="@own.Id"/><input type="hidden" name="slug" value="@Model.Blog.Slug"/>
<label for="edit-comment-@own.Id">Yorum içeriği</label><textarea id="edit-comment-@own.Id" name="content" required maxlength="1000" class="form-control">@own.Content</textarea>
<button class="btn btn-secondary mt-2">Güncelle ve yeniden onaya gönder</button></form>
<form asp-controller="Comment" asp-action="Delete" method="post"><input type="hidden" name="id" value="@own.Id"/><input type="hidden" name="slug" value="@Model.Blog.Slug"/><button class="btn btn-outline-danger mt-2">Sil</button></form>
</details>
}
}
}
else{<a asp-controller="Dashboard" asp-action="SignIn">Yorum yapmak için giriş yapın</a>}
</section>
