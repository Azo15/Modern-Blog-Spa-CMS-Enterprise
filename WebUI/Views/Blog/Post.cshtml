@model WebUI.Models.BlogPostViewModel
@{ViewData["Title"]=Model.Blog.Title;var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
<header class="luxe-post-header"><div class="container"><span class="luxe-eyebrow">@Model.Blog.CategoryTitle</span><h1>@Model.Blog.Title</h1><div class="luxe-post-meta"><span><i class="fa-regular fa-user" aria-hidden="true"></i>@Model.Blog.AuthorName</span><time datetime="@Model.Blog.CreatedDate.ToString("yyyy-MM-dd")">@Model.Blog.CreatedDate.ToString("dd MMMM yyyy")</time><span><i class="fa-regular fa-clock" aria-hidden="true"></i>@ViewBag.ReadingTime @L["ReadingMinutes"]</span></div></div></header>
<div class="container"><img class="luxe-post-cover" src="@Media.BlogImage(Model.Blog.Title,Model.Blog.Image)" alt="@Model.Blog.Title" width="1200" height="460" fetchpriority="high" /></div>
<article class="luxe-article"><a class="luxe-text-link mb-5" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>@L["AllPosts"]</a><div class="luxe-prose">@Html.Raw(SafeHtml.Sanitize(Model.Blog.Content))</div>@await Component.InvokeAsync("BlogInteraction",new {blogId=Model.Blog.Id,slug=Model.Blog.Slug})</article>
@await Html.PartialAsync("_Comments",Model)
@if(ViewBag.RelatedBlogs is IEnumerable<BusinessLayer.Dtos.BlogListDto> related && related.Any()){<section class="luxe-section luxe-section-light"><div class="container"><div class="luxe-section-heading"><div><span class="luxe-eyebrow">@(en?"CONTINUE YOUR JOURNEY":"KEŞFE DEVAM EDİN")</span><h2>@L["RelatedPosts"]</h2></div></div><div class="luxe-blog-grid">@await Html.PartialAsync("_BlogCardPartial",related.Take(3))</div></div></section>}
