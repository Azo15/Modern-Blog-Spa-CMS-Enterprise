@model BusinessLayer.Dtos.PaginatedList<BusinessLayer.Dtos.BlogListDto>
@{ViewData["Title"]=L["Blog"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";var categories=ViewBag.PublicCategories as IEnumerable<BusinessLayer.Dtos.PublicCategoryDto>??Enumerable.Empty<BusinessLayer.Dtos.PublicCategoryDto>();}
<section class="luxe-page-hero"><div class="container"><span class="luxe-eyebrow">@(en?"THE WELLBEING JOURNAL":"İYİ YAŞAM GÜNLÜĞÜ")</span><h1 class="luxe-title">@(en?"A little inspiration,":"Bir tutam ilham,")<br /><em>@(en?"for a better everyday.":"biraz daha iyi yaşam.")</em></h1><p class="luxe-lead">@L["BlogSubtitle"]</p><span class="luxe-page-number">02 / JOURNAL</span></div></section>
<section class="luxe-section"><div class="container"><p class="luxe-blog-statistics"><i class="fa-solid fa-book-open" aria-hidden="true"></i> <b data-blog-total>@ViewBag.PublishedArticleCount</b> @(en ? "articles" : "makale") <span>·</span> <b data-category-total>@categories.Count(category => category.BlogCount > 0)</b> @(en ? "categories" : "kategori") <span>·</span> @(en ? "New stories every week" : "Haftada yeni içerikler")</p></div><div class="container"><div class="luxe-filter-bar"><div class="luxe-category-links"><a asp-action="Index" asp-route-search="@ViewBag.Search" class="@(ViewBag.CategoryId==null?"active":"")">@(en?"All stories":"Tüm yazılar")</a>@foreach(var category in categories.Where(c=>c.BlogCount>0)){<a asp-action="Index" asp-route-categoryId="@category.Id" asp-route-search="@ViewBag.Search" class="@(ViewBag.CategoryId==category.Id?"active":"")">@category.Title <small>(@category.BlogCount)</small></a>}</div><form class="luxe-search" method="get" asp-action="Index"><input type="hidden" name="categoryId" value="@ViewBag.CategoryId" /><label class="visually-hidden" for="blog-search">@(en?"Search journal":"Günlükte ara")</label><input id="blog-search" type="search" aria-controls="blog-results" aria-describedby="blog-search-status" name="search" maxlength="100" value="@ViewBag.Search" placeholder="@(en?"Search blog posts…":"Blog yazısı ara...")" /><button type="submit" aria-label="@(en?"Search":"Ara")"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button></form></div><p id="blog-search-status" class="luxe-search-status" role="status" aria-live="polite"></p><div class="luxe-blog-grid" id="blog-results">@await Html.PartialAsync("_BlogCardPartial",Model.Items)</div><p id="blog-search-empty" class="luxe-empty" hidden>@(en ? "No results found" : "Sonuç bulunamadı")</p>@if(Model.Items.Count==0){<p class="luxe-empty">@(en?"No published stories match your search.":"Aramanızla eşleşen yayımlanmış bir yazı bulunamadı.")</p>}<nav class="luxe-pagination" aria-label="@(en?"Journal pages":"Günlük sayfaları")">@if(Model.HasPreviousPage){<a asp-action="Index" asp-route-page="@(Model.PageIndex-1)" asp-route-categoryId="@ViewBag.CategoryId" asp-route-search="@ViewBag.Search">← @L["Previous"]</a>}<span>@L["Page"] @Model.PageIndex / @Math.Max(1,Model.TotalPages)</span>@if(Model.HasNextPage){<a asp-action="Index" asp-route-page="@(Model.PageIndex+1)" asp-route-categoryId="@ViewBag.CategoryId" asp-route-search="@ViewBag.Search">@L["Next"] →</a>}</nav></div></section>
