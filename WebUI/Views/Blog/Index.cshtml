@model BusinessLayer.Dtos.PaginatedList<BusinessLayer.Dtos.BlogListDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}


<div id="blog" >
    <section class="section section-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="section-title font-playfair" data-aos="fade-up">Blog</h1>
                    <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                        Sağlık, güzellik ve wellness hakkında faydalı bilgiler
                    </p>
                </div>
            </div>

            <div class="row g-3">
                @await Html.PartialAsync("_BlogCardPartial", Model.Items)
            </div>
            
            <nav class="mt-4" aria-label="Blog sayfaları">
                @if(Model.HasPreviousPage){<a asp-action="Index" asp-route-page="@(Model.PageIndex-1)" asp-route-categoryId="@ViewBag.CategoryId">Önceki</a>}
                <span>Sayfa @Model.PageIndex / @Math.Max(1,Model.TotalPages)</span>
                @if(Model.HasNextPage){<a asp-action="Index" asp-route-page="@(Model.PageIndex+1)" asp-route-categoryId="@ViewBag.CategoryId">Sonraki</a>}
            </nav>
        </div>
    </section>
</div>

