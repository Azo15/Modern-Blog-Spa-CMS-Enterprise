@model IEnumerable<BusinessLayer.Dtos.BlogListDto>
@{
    int index = 0;
}
@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        int delay = 200 + ((index % 4) * 200);
        var imgPath = string.IsNullOrEmpty(item.Image) ? "img/default-image.jpg" : item.Image;

        <div class="col-6 col-lg-4 col-xl-3 mb-4" data-aos="fade-up" data-aos-delay="@delay">
            <a class="blog-card-a h-100" asp-controller="Blog" asp-action="Post" asp-route-slug="@item.Slug">
                <div class="blog-card h-100">
                    <div class="blog-image">
                        <img src="~/@imgPath" alt="@item.Title" />
                        <div class="blog-date">@item.CategoryTitle</div>
                    </div>
                    <div class="blog-content">
                        <h3 class="blog-title">@item.Title</h3>
                        <p class="blog-excerpt">@item.SubTitle</p>
                        <div class="blog-meta">
                            <div class="blog-author">
                                <i class="fas fa-user-circle"></i>
                                @item.AuthorName
                            </div>
                            <span>@item.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        index++;
    }
}