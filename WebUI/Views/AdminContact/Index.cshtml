@model IEnumerable<Contact>

@{
    ViewData["Title"] = L["İletişim Bilgisi Listesi"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int sayac = 1;
}

<div class="card">
    <div class="justify-content-between d-flex align-items-center px-4">
        <h5 class="card-header">@ViewData["Title"]</h5>
        @if (Model.Count() < 1)
        {
            <a asp-action="Create" class="btn btn-outline-primary"><i class="fa-solid fa-plus me-md-2"></i>Bilgi Ekle</a>
        }
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>
                        @Html.DisplayNameFor(model => model.Mail)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Phone)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Adres)
                    </th>
                    <th>@L["Eylemler"]</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {

                <tr>
                    <td>
                        @sayac
                    </td>

                    <td>
                        @item.Mail
                    </td>

                    <td>
                        @item.Phone
                    </td>

                    <td class="td-m-0">
                        @(item.Adres != null && item.Adres.Length > 50
                                                ? item.Adres.Substring(0, 50) + "..."
                                                : item.Adres)
                    </td>

                    <td>
                        <div class="dropdown">
                            <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <div class="dropdown-menu">
                                <a class="dropdown-item text-warning" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> @L["Düzenle"]
                                </a>
                                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-trash me-1"></i> @L["Sil"]
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
                                sayac++;
                }
            </tbody>
        </table>
        <hr class="mt-0" />
        <div class="px-5">
            <p><small>Tabloda</small><span class="mx-2">@ViewBag.Count</span><small>adet veri var</small></p>
        </div>
    </div>
</div>
