@model Contact

@{
    ViewData["Title"] = L["İletişim Bilgisi Güncelleme"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label">Telefon Numarası</label>
                    <input type="tel" asp-for="Phone" class="form-control" placeholder="90 *** *** ** **">
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Mail" class="form-label">E-Mail Adresi</label>
                    <input type="email" asp-for="Mail" class="form-control" placeholder="ornek@mail.com">
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="InstagramUrl" class="form-label">Instagram Kullanıcı Adı</label>
                    <input type="text" asp-for="InstagramUrl" class="form-control" placeholder="Instagram URL">
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="FacebookUrl" class="form-label">Facebook Kullanıcı Adı</label>
                    <input type="text" asp-for="FacebookUrl" class="form-control" placeholder="Facebook URL">
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TwitterUrl" class="form-label">Twitter Kullanıcı Adı</label>
                    <input type="text" asp-for="TwitterUrl" class="form-control" placeholder="Twitter URL">
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="YoutubeUrl" class="form-label">YouTube Kullanıcı Adı</label>
                    <input type="text" asp-for="YoutubeUrl" class="form-control" placeholder="YouTube URL">
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Adres" class="form-label">@L["Adres"]</label>
                    <textarea rows="4" asp-for="Adres" class="form-control" placeholder="Adres giriniz"></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> @L["Geri Dön"]
                </a>

                <button type="submit" class="btn btn-primary ">
                    <i class="bi bi-check-circle"></i> @L["Güncelle"]
                </button>
            </div>

        </form>
    </div>
</div>
