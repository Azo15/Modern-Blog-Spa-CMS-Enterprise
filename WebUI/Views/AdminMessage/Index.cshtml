@model IEnumerable<ContactForm>

@{
    ViewData["Title"] = L["Messages"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int sayac = 1;
}

@section Styles {
    <link href="~/css/rezervationTime.css" rel="stylesheet" />
}

<div class="card">
    <div class="justify-content-between d-flex align-items-center px-4">
        <h5 class="card-header">@ViewData["Title"]</h5>
        <div class="d-flex gap-2">
            <a asp-controller="Reports" asp-action="Contacts" asp-route-format="Excel" class="btn btn-outline-success">@L["ExportExcel"]</a>
            <a asp-controller="Reports" asp-action="Contacts" asp-route-format="Pdf" class="btn btn-outline-danger">@L["ExportPdf"]</a>
        </div>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>
                        @Html.DisplayNameFor(model => model.FullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Subject)
                    </th>
                    <th>
                        @L["DateUtc"]
                    </th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@sayac</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Subject</td>
                        <td>@item.CreatedDate.ToString("dd MMMM yyyy HH:mm")</td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-warning" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> @L["Details"]
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    sayac++;
                }
            </tbody>
        </table>
        <hr class="mt-0" />
        <div class="px-5">
            <p><small>Tabloda</small><span class="mx-2">@ViewBag.Count</span><small>adet veri var</small></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/rezervationTime.js"></script>
}
