@model IEnumerable<ContactForm>

@{
    ViewData["Title"] = "Rezervasyon Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int sayac = 1;
}

@section Styles {
    <link href="~/css/rezervationTime.css" rel="stylesheet" />
}

<div class="card">
    <div class="justify-content-between d-flex align-items-center px-4">
        <h5 class="card-header">Rezervasyonlar</h5>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>
                        @Html.DisplayNameFor(model => model.FullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Subject)
                    </th>
                    <th>
                        Bekleme Süresi
                    </th>
                    <th>Eylemler</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@sayac</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Subject</td>
                        <td data-created-date="@item.CreatedDate.ToString("o")">
                            @* ISO 8601 formatında tarih *@
                            <div class="reservation-timer-container">
                                <div class="reservation-timer-progress" style="width: 0%; background-position: 0%;"></div>
                                <span class="reservation-timer-text">Yükleniyor...</span>
                            </div>
                        </td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-warning" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Detay
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    sayac++;
                }
            </tbody>
        </table>
        <hr class="mt-0" />
        <div class="px-5">
            <p><small>Tabloda</small><span class="mx-2">@ViewBag.Count</span><small>adet veri var</small></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/rezervationTime.js"></script>
}