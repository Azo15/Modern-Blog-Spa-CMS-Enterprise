@model ContactPageViewModel
@{ViewData["Title"]=L["Contact"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";var address=Model.Contact?.Adres;var mapQuery=string.IsNullOrWhiteSpace(address)?"Kırklareli":address;var siteKey=ViewData["SiteKey"] as string;}
<section class="luxe-page-hero"><div class="container"><span class="luxe-eyebrow">@(en?"A PERSONAL INVITATION":"SİZE ÖZEL BİR DAVET")</span><h1 class="luxe-title">@(en?"Your moment of calm":"Dinginliğe giden yol,")<br /><em>@(en?"begins here.":"bir merhabayla başlar.")</em></h1><p class="luxe-lead">@(en?"A question, a first visit, a ritual just for you. We would love to help you plan it.":"Bir soru, ilk ziyaretiniz, size özel bir ritüel. Deneyiminizi birlikte planlayalım.")</p><span class="luxe-page-number">04 / CONNECT</span></div></section>
<section class="luxe-section"><div class="container luxe-contact-grid"><aside class="luxe-contact-sidebar" data-aos="fade-up"><span class="luxe-eyebrow">@(en?"LET'S TALK":"BİRLİKTE PLANLAYALIM")</span><h2>@(en?"A little closer":"Size iyi gelecek")<br /><em>@(en?"to feeling good.":"bir başlangıç.")</em></h2><p>@(en?"Contact us directly to find an experience and appointment that suits you.":"Size uygun deneyimi ve randevuyu seçmek için bizimle doğrudan iletişime geçin.")</p><div class="luxe-info-card"><i class="fa-solid fa-phone" aria-hidden="true"></i><div><h3>@L["Phone"]</h3><a class="luxe-contact-phone" href="tel:+905388787000">+90 538 878 70 00</a></div></div><div class="luxe-info-card"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><div><h3>WHATSAPP</h3><a href="https://wa.me/905388787000" target="_blank" rel="noopener noreferrer">@(en?"Your personal appointment line":"Size özel randevu hattı") <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></div></div>@if(!string.IsNullOrWhiteSpace(Model.Contact?.Mail)){<div class="luxe-info-card"><i class="fa-regular fa-envelope" aria-hidden="true"></i><div><h3>@L["Email"]</h3><a href="mailto:@Model.Contact.Mail">@Model.Contact.Mail</a></div></div>}@if(!string.IsNullOrWhiteSpace(address)){<div class="luxe-info-card"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><div><h3>@L["Address"]</h3><p>@address</p><a class="luxe-text-link mt-2" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(mapQuery)" target="_blank" rel="noopener noreferrer">@(en?"Get directions":"Yol tarifi alın") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></div>}<div class="luxe-hours"><h3>@(en?"At your own pace":"Sizin ritminizde")</h3><p>@(en?"Please contact our appointment line for current opening hours and availability.":"Güncel çalışma saatlerimiz ve uygun randevular için randevu hattımızdan bilgi alabilirsiniz.")</p></div></aside><div class="luxe-contact-form" data-aos="fade-up"><h2>@(en?"Leave us a note.":"Bize bir not bırakın.")</h2><p>@(en?"Tell us a little about what you have in mind.":"Nasıl bir deneyim aradığınızı bizimle paylaşın.")</p>@if(ViewData["NewsletterNotice"] is string notice){<div class="alert alert-info" role="status">@notice</div>}<form asp-controller="Contact" asp-action="SendMessage" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><div class="form-floating"><input asp-for="ContactForm.FullName" class="form-control" placeholder="@L["FirstName"]" autocomplete="name" required /><label asp-for="ContactForm.FullName"></label></div><span asp-validation-for="ContactForm.FullName" class="text-danger small"></span></div><div class="col-md-6"><div class="form-floating"><input asp-for="ContactForm.Email" class="form-control" type="email" placeholder="@L["Email"]" autocomplete="email" required /><label asp-for="ContactForm.Email"></label></div><span asp-validation-for="ContactForm.Email" class="text-danger small"></span></div><div class="col-md-6"><div class="form-floating"><input asp-for="ContactForm.Phone" class="form-control" type="tel" placeholder="@L["Phone"]" autocomplete="tel" /><label asp-for="ContactForm.Phone"></label></div><span asp-validation-for="ContactForm.Phone" class="text-danger small"></span></div><div class="col-md-6"><div class="form-floating"><input asp-for="ContactForm.Subject" class="form-control" placeholder="@L["Contact"]" required /><label asp-for="ContactForm.Subject"></label></div><span asp-validation-for="ContactForm.Subject" class="text-danger small"></span></div><div class="col-12"><div class="form-floating"><textarea asp-for="ContactForm.Message" class="form-control" placeholder="@L["MessagePlaceholder"]" required maxlength="5000"></textarea><label asp-for="ContactForm.Message"></label></div><span asp-validation-for="ContactForm.Message" class="text-danger small"></span></div></div><p class="luxe-form-note">@(en?"Your information is used to respond to your request.":"Bilgileriniz, talebinize yanıt vermek amacıyla kullanılır.")</p>@if(!string.IsNullOrWhiteSpace(siteKey)){<div class="g-recaptcha mb-4" data-sitekey="@siteKey"></div>}else{<p class="luxe-form-note">@(en?"Please call or message us on WhatsApp while our message form is unavailable.":"Mesaj formu şu an kullanılamıyor. Telefon veya WhatsApp üzerinden bize ulaşabilirsiniz.")</p>}<button type="submit" class="luxe-button luxe-button-dark" disabled="@(string.IsNullOrWhiteSpace(siteKey))">@L["SendContact"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></form></div></div></section>
<section class="luxe-map" aria-label="@(en?"Location map":"Konum haritası")"><iframe src="https://maps.google.com/maps?q=@Uri.EscapeDataString(mapQuery)&amp;output=embed" title="@(en?"XSPA location":"XSPA konumu")" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(mapQuery)" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@(en?"Find us in Kırklareli":"Kırklareli'de buluşalım") <i class="fa-solid fa-arrow-up-right-from-square ms-3" aria-hidden="true"></i></a></section>
@section Scripts{
<script>document.addEventListener('DOMContentLoaded',()=>{const message=@Html.Raw(Json.Serialize(TempData["Swal_Message"]??""));if(message&&window.Swal)Swal.fire({title:@Html.Raw(Json.Serialize(TempData["Swal_Title"]??"")),text:message,icon:@Html.Raw(Json.Serialize(TempData["Swal_Icon"]??"info")),confirmButtonText:@Html.Raw(Json.Serialize(L["Okay"].Value))});});</script>
@if(!string.IsNullOrWhiteSpace(siteKey)){<script src="https://www.google.com/recaptcha/api.js" async defer></script>}
}
