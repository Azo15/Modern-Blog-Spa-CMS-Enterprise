@model AboutCard
@{ViewData["Title"]=L["AboutCards"];Layout="~/Views/Shared/_AdminLayout.cshtml";}
<div class="card"><div class="card-body"><h1 class="h3">@L["AboutCards"]</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Title" class="form-label">@L["Title"]</label><input asp-for="Title" class="form-control" maxlength="200" required /></div><div class="mb-3"><label asp-for="Content" class="form-label">@L["Content"]</label><textarea asp-for="Content" class="form-control" rows="5" maxlength="5000" required></textarea></div><button class="btn btn-primary" type="submit">@L["Save"]</button><a class="btn btn-outline-secondary ms-2" asp-action="Index">@L["Cancel"]</a></form></div></div>
