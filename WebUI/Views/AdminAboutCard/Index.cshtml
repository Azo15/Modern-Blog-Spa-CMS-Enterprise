@model IEnumerable<AboutCard>
@{ViewData["Title"]=L["AboutCards"];Layout="~/Views/Shared/_AdminLayout.cshtml";}
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">@L["AboutCards"]</h1><a class="btn btn-primary" asp-action="Create">@L["Create"]</a></div>
<div class="card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>@L["Title"]</th><th>@L["Content"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Title</td><td>@(item.Content?.Length>130?item.Content[..130]+"…":item.Content)</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@L["Edit"]</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-2">@L["Delete"]</a></td></tr>}</tbody></table></div></div>
