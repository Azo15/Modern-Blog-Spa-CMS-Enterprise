@model List<WebUI.Models.UserWithRolesViewModel>

@{
    ViewData["Title"] = L["Kullanıcı & Rol Yönetimi"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int sayac = 1;
}

<div class="card">
    <div class="justify-content-between d-flex align-items-center px-4 pt-3 pb-2">
        <h5 class="card-header m-0 p-0">
            <i class="fa-solid fa-users-gear me-2"></i>Kullanıcı & Rol Yönetim Paneli
        </h5>
        <span class="badge bg-primary fs-6">Toplam: @Model.Count Kullanıcı</span>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["Kullanıcı"]</th>
                    <th>E-Posta</th>
                    <th>Tanımlı Roller</th>
                    <th>Hesap Durumu</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@sayac</td>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="~/@item.Image" alt="avatar" class="rounded-circle me-2" style="width:38px; height:38px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="avatar avatar-sm me-2">
                                        <span class="avatar-initial rounded-circle bg-label-primary">
                                            @(!string.IsNullOrEmpty(item.FullName) ? item.FullName.Substring(0, 1).ToUpper() : "U")
                                        </span>
                                    </div>
                                }
                                <div>
                                    <strong>@item.FullName</strong>
                                </div>
                            </div>
                        </td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.Roles.Any())
                            {
                                foreach (var role in item.Roles)
                                {
                                    string badgeClass = role switch
                                    {
                                        "System Admin" => "bg-danger",
                                        "Staff" => "bg-primary",
                                        "Customer" => "bg-success",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @badgeClass me-1">@role</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-label-secondary">Rol Yok</span>
                            }
                        </td>
                        <td>
                            @if (item.IsLockedOut)
                            {
                                <span class="badge bg-label-danger"><i class="fa-solid fa-lock me-1"></i>Kilitli</span>
                            }
                            else
                            {
                                <span class="badge bg-label-success"><i class="fa-solid fa-check me-1"></i>@L["Aktif"]</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="AssignRole" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-user-shield me-1"></i>Rol Ata
                                </a>
                                <form asp-action="ToggleLock" asp-route-id="@item.UserId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (item.IsLockedOut)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Bu kullanıcının kilidini kaldırmak istediğinize emin misiniz?');">
                                            <i class="fa-solid fa-lock-open me-1"></i>Kilidi Aç
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Bu kullanıcı hesabını kilitlemek istediğinize emin misiniz?');">
                                            <i class="fa-solid fa-user-lock me-1"></i>Kilitle
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                    sayac++;
                }
            </tbody>
        </table>
    </div>
</div>
