@inject Microsoft.AspNetCore.Authorization.IAuthorizationService NotificationAuthorization
<script src="~/admin/vendor/libs/jquery/jquery.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/admin/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
<script src="~/admin/vendor/js/menu.js"></script>
<script src="~/admin/vendor/libs/apex-charts/apexcharts.js"></script>
<script src="~/admin/js/main.js"></script>
<script src="~/admin/js/dropzone.min.js"></script>
<script src="~/admin/js/imagePreview.js"></script>
<script src="~/admin/vendor/jquery/jquery-ui.min.js"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<!-- tiny ide -->
<script src="~/admin/vendor/tinymce/tinymce.min.js"></script>
<script src="~/admin/js/theme-toggle.js" asp-append-version="true"></script>
<script src="~/js/taos/toastr.min.js"></script>

<script src="~/admin/js/site-sortable.js" asp-append-version="true"></script>

@if ((await NotificationAuthorization.AuthorizeAsync(User, null, BusinessLayer.Security.AccessPolicies.Moderator)).Succeeded)
{
<!-- 📌 SignalR Real-Time Notification Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const soundButton = document.getElementById('notification-sound');
        const english = document.documentElement.lang.startsWith('en');
        let audio;
        let soundOn = false;
        const updateSoundButton = () => {
            if (!soundButton) return;
            soundButton.setAttribute('aria-pressed', String(soundOn));
            soundButton.textContent = soundOn ? (english ? 'Notification sound on' : 'Bildirim sesi açık') : (english ? 'Enable notification sound' : 'Bildirim sesini aç');
        };
        soundButton?.addEventListener('click', async () => {
            try {
                if (!audio) audio = new (window.AudioContext || window.webkitAudioContext)();
                await audio.resume();
                soundOn = !soundOn;
                updateSoundButton();
            } catch { soundOn = false; updateSoundButton(); }
        });
        const playReservationSound = () => {
            if (!soundOn || audio?.state !== 'running') return;
            [660, 880].forEach((frequency, index) => {
                const oscillator = audio.createOscillator(), volume = audio.createGain();
                const start = audio.currentTime + index * .2;
                oscillator.type = 'sine'; oscillator.frequency.value = frequency;
                volume.gain.setValueAtTime(0, start); volume.gain.linearRampToValueAtTime(.09, start + .02); volume.gain.exponentialRampToValueAtTime(.001, start + .25);
                oscillator.connect(volume); volume.connect(audio.destination); oscillator.start(start); oscillator.stop(start + .28);
            });
        };
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveNotification", function (title, message, type) {
            if (title === 'Yeni Rezervasyon') playReservationSound();
            if (typeof toastr !== "undefined") {
                toastr.options = {
                    "closeButton": true,
                    "escapeHtml": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "timeOut": "8000"
                };
                if (type === "success") toastr.success(message, title);
                else if (type === "error") toastr.error(message, title);
                else if (type === "warning") toastr.warning(message, title);
                else toastr.info(message, title);
            } else {
                alert(title + ": " + message);
            }
        });

        connection.start().then(function () {
            console.log("🟢 SignalR Canlı Bildirim Bağlantısı Başarılı!");
        }).catch(function (err) {
            console.error("🔴 SignalR Bağlantı Hatası:", err.toString());
        });
    });
</script>
}
