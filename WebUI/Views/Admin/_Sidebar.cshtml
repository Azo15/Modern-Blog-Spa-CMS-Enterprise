        <li class="menu-header small text-uppercase mt-4"><span class="menu-header-text">Hizmetler</span></li>

        <li class="menu-item @(Html.IsActive("AdminService"))">
            <a asp-controller="AdminService" asp-action="Index" class="menu-link">
