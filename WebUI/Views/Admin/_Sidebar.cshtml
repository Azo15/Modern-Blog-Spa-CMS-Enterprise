                <div class="text-truncate">İletişim Bilgileri</div>
            </a>
        </li>

        <li class="menu-item @(Html.IsActive("AdminMessage"))">
            <a asp-controller="AdminMessage" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-inbox"></i>
                <div class="text-truncate">Gelen Mesajlar</div>
            </a>
        </li>

        <!-- BLOG YÖNETİMİ -->
        <li class="menu-header small text-uppercase mt-4"><span class="menu-header-text">Blog Yönetimi</span></li>

        <li class="menu-item @(Html.IsActive("AdminBlog"))">
            <a asp-controller="AdminBlog" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-newspaper"></i>
                <div class="text-truncate">Bloglar</div>
            </a>
        </li>

        <li class="menu-item @(Html.IsActive("AdminCatagory"))">
            <a asp-controller="AdminCatagory" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-tags"></i>
                <div class="text-truncate">Blog Kategorileri</div>
            </a>
        </li>

