        <li class="menu-item @(Html.IsActive("AdminGalary"))">
            <a asp-controller="AdminGalary" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-images"></i>
                <div class="text-truncate">Galeri</div>
            </a>
