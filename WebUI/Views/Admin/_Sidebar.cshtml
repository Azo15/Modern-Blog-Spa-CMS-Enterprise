@using Microsoft.AspNetCore.Authorization
@using BusinessLayer.Security
@inject IAuthorizationService Authorization
@{
    var admin = (await Authorization.AuthorizeAsync(User, AccessPolicies.Admin)).Succeeded;
    var content = (await Authorization.AuthorizeAsync(User, AccessPolicies.ContentManager)).Succeeded;
    var blog = (await Authorization.AuthorizeAsync(User, AccessPolicies.BlogAuthor)).Succeeded;
    var moderation = (await Authorization.AuthorizeAsync(User, AccessPolicies.Moderator)).Succeeded;
}
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
    <div class="app-brand demo"><a asp-controller="Default" asp-action="Index" class="app-brand-link"><span class="app-brand-text demo menu-text fw-bold ms-2">X Spa</span></a></div>
    <ul class="menu-inner py-5">
    @if (admin)
    {
        <li class="menu-header">Sistem Yönetimi</li>
        <li class="menu-item"><a asp-controller="AdminUserList" asp-action="UserList" class="menu-link">Kullanıcılar</a></li>
        <li class="menu-item"><a asp-controller="AdminUserRole" asp-action="Index" class="menu-link">Rol Yönetimi</a></li>
        <li class="menu-item"><a asp-controller="AdminSiteInfo" asp-action="Index" class="menu-link">Site Ayarları</a></li>
    }
    @if (blog)
    {
        <li class="menu-header">Blog Yönetimi</li>
        <li class="menu-item"><a asp-controller="AdminBlog" asp-action="Index" class="menu-link">Bloglar</a></li>
    }
    @if (content)
    {
        <li class="menu-item"><a asp-controller="AdminBlog" asp-action="Trash" class="menu-link">Çöp Kutusu</a></li>
        <li class="menu-item"><a asp-controller="AdminCatagory" asp-action="Index" class="menu-link">Kategoriler</a></li>
        <li class="menu-item"><a asp-controller="AdminAbout" asp-action="Index" class="menu-link">Hakkımızda</a></li>
        <li class="menu-item"><a asp-controller="AdminAboutCard" asp-action="Index" class="menu-link">Hakkımızda Kartları</a></li>
        <li class="menu-item"><a asp-controller="AdminContact" asp-action="Index" class="menu-link">İletişim Bilgileri</a></li>
        <li class="menu-item"><a asp-controller="AdminSlider" asp-action="Index" class="menu-link">Slider</a></li>
        <li class="menu-item"><a asp-controller="AdminGalary" asp-action="Index" class="menu-link">Galeri</a></li>
        <li class="menu-item"><a asp-controller="AdminService" asp-action="Index" class="menu-link">Hizmetler</a></li>
    }
    @if (moderation)
    {
        <li class="menu-item"><a asp-controller="AdminMessage" asp-action="Index" class="menu-link">Gelen Mesajlar</a></li>
    }
    </ul>
</aside>
