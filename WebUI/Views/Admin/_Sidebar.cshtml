        </li>

        <!-- GENEL PANEL -->
        <li class="menu-header small text-uppercase"><span class="menu-header-text">Genel Panel</span></li>

        <li class="menu-item @(Html.IsActive("AdminAbout"))">
            <a asp-controller="AdminAbout" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-building-user"></i>
                <div class="text-truncate">Hakkımızda</div>
            </a>
        </li>

        <li class="menu-item @(Html.IsActive("AdminAboutCard")) d-none">
            <a asp-controller="AdminAboutCard" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-id-card-clip"></i>
                <div class="text-truncate">Hakkımızda Kartları</div>
            </a>
        </li>

        <li class="menu-item @(Html.IsActive("AdminContact"))">
            <a asp-controller="AdminContact" asp-action="Index" class="menu-link">
