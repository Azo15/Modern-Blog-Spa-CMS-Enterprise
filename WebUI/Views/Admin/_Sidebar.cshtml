<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

    <!-- Logo ve Toggle -->
    <div class="app-brand demo">
        <a asp-controller="Default" asp-action="Index" target="_blank" class="app-brand-link">
            <span class="app-brand-text demo menu-text fw-bold ms-2">
                <span class="app-brand-text-full">X Spa</span>
                <span class="app-brand-text-collapsed">XS</span>
            </span>
        </a>

        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-none d-xl-block px-2 py-1" style="z-index: 100;">
            <i class="fa-solid fa-bars text-white w-100 h-100"></i>
        </a>
    </div>

    <div class="menu-divider mt-0"></div>
    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-5">

        <!-- ADMIN -->
        <li class="menu-header small text-uppercase"><span class="menu-header-text">Admin</span></li>

        <li class="menu-item @(Html.IsActive("AdminUserList"))">
            <a asp-controller="AdminUserList" asp-action="UserList" class="menu-link">
                <i class="menu-icon fa-solid fa-users"></i>
                <div class="text-truncate">Admin Listesi</div>
            </a>
        </li>

        <li class="menu-item @(Html.IsActive("AdminUserRole"))">
            <a asp-controller="AdminUserRole" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-user-shield"></i>
                <div class="text-truncate">Rol & Kullanıcı Yönetimi</div>
            </a>
        </li>

        <li class="menu-item @(Html.IsActive("AdminSiteInfo"))">
            <a asp-controller="AdminSiteInfo" asp-action="Index" class="menu-link">
                <i class="menu-icon fa-solid fa-sliders"></i>
                <div class="text-truncate">Site Ayarları</div>
