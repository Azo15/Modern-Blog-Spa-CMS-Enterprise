@model Service
@{ViewData["Title"]=Model.Title;var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
<section class="luxe-page-hero"><div class="container"><span class="luxe-eyebrow">@(en?"YOUR PERSONAL RITUAL":"SİZE ÖZEL BİR RİTÜEL")</span><h1 class="luxe-title">@Model.Title</h1><p class="luxe-lead">@Model.Content</p></div></section>
<section class="luxe-section"><div class="container luxe-story"><div class="luxe-story-media" data-aos="fade-up"><img src="@Media.ServiceImage(Model.Title,Model.Image,Model.Id)" alt="@Model.Title" width="1200" height="1200" /></div><div class="luxe-story-text" data-aos="fade-up"><span class="luxe-eyebrow">@(en?"SLOW DOWN, SETTLE IN":"YAVAŞLAYIN, DİNLENİN")</span><h2>@(en?"A moment":"Bu an,")<br /><em>@(en?"just for you.":"sadece sizin.")</em></h2><div class="luxe-prose">@Html.Raw(SafeHtml.Sanitize(Model.Details))</div><div class="luxe-signature">@Model.Content</div><a class="luxe-button luxe-button-dark" href="https://wa.me/905388787000?text=@Uri.EscapeDataString((en?"Hello, I would like information about ":"Merhaba, bilgi ve randevu almak istiyorum: ")+Model.Title)" target="_blank" rel="noopener noreferrer">@(en?"Plan this experience":"Bu deneyimi planlayın") <i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a><p class="mt-4"><a class="luxe-text-link" asp-action="Index">@(en?"All rituals":"Tüm ritüeller") <i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a></p></div></div></section>
