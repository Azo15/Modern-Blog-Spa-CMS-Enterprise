@model IEnumerable<Service>
@{ViewData["Title"]=L["Services"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
<section class="luxe-page-hero"><div class="container"><span class="luxe-eyebrow">@(en?"TAILORED TO YOU":"SİZE ÖZEL DENEYİMLER")</span><h1 class="luxe-title">@(en?"Find your":"Kendinize ait")<br /><em>@(en?"ritual of calm.":"ritüeli bulun.")</em></h1><p class="luxe-lead">@(en?"From a gentle massage to a timeless hammam. Choose a moment that feels right for you.":"Zarif bir masajdan zamansız hamam ritüeline. Size iyi gelen deneyimi seçin.")</p><span class="luxe-page-number">01 / RITUALS</span></div></section>
<section class="luxe-section"><div class="container"><div class="luxe-service-filters" data-service-filters hidden role="group" aria-label="@(en ? "Filter rituals" : "Ritüelleri filtrele")">
@foreach(var filter in new[] { ("all", en ? "All rituals" : "Tüm Ritüeller"), ("massage", en ? "Massage therapies" : "Masaj Terapileri"), ("hammam", en ? "Hammam & cleansing" : "Hamam & Kese"), ("care", en ? "Skin & face care" : "Cilt & Yüz Bakımı"), ("detox", en ? "Sauna & detox" : "Sauna & Detoks") }){<button type="button" data-service-filter="@filter.Item1" aria-pressed="@(filter.Item1=="all" ? "true" : "false")">@filter.Item2</button>}
</div><p class="luxe-filter-count" data-service-count role="status" aria-live="polite"></p><div class="luxe-service-grid" data-filtered-services>@await Html.PartialAsync("_ServiceCardPartial",Model)</div>@if(!Model.Any()){<p class="luxe-empty">@(en?"Contact us to plan your ritual.":"Ritüelinizi planlamak için bize ulaşın.")</p>}@if(ViewBag.PaginationInfo!=null){<div class="mt-5">@await Component.InvokeAsync("Pagination",new {paginationInfo=ViewBag.PaginationInfo})</div>}</div></section>
