@model IEnumerable<Service>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<section class="section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="section-title font-playfair text-white" data-aos="fade-up">Hizmetlerimiz</h1>
                <p class="section-subtitle text-white" data-aos="fade-up" data-aos-delay="100">
                    Size özel tasarlanmış spa ve wellness hizmetleri
                </p>
            </div>
        </div>

        <div class="row g-3">
            @await Html.PartialAsync("_ServiceCardPartial", Model)
        </div>
        
        @if (ViewBag.PaginationInfo != null)
        {
            <div class="row mt-4">
                <div class="col-12">
                    @await Component.InvokeAsync("Pagination", new { paginationInfo = ViewBag.PaginationInfo })
                </div>
            </div>
        }
    </div>
</section>
