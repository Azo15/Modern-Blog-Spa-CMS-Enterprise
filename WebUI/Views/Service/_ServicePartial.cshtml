@model IEnumerable<Service>

@{
    int index = 0;
}

@foreach (var item in Model)
{
    int delay = 200 + ((index % 4) * 200);
    <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="@delay">
        <div class="service-card">

            <div class="service-icon overflow-hidden">
                <img src="~/@item.Image" class="service-card-img" />
            </div>

            <h3 class="service-title">@item.Title</h3>

            <p class="service-description">
                @(Html.Raw(item.Details.Length > 150 ? item.Details.Substring(0, 150) + "..." : item.Details))
            </p>

            <div class="service-price">@item.Content</div>

        </div>
    </div>
    index++;
}
