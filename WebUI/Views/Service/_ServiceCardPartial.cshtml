@model IEnumerable<Service>
@{var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";var index=0;}
@foreach(var item in Model){
    var text=(item.Title??"").ToLowerInvariant();var icon=text.Contains("hamam")?"hot-tub-person":text.Contains("sauna")?"wind":text.Contains("maske")?"gem":text.Contains("refleks")?"leaf":text.Contains("derin")?"hands-holding-circle":"spa";
    var details=System.Text.RegularExpressions.Regex.Replace(SafeHtml.Sanitize(item.Details),"<[^>]*>"," "); details=System.Net.WebUtility.HtmlDecode(details);if(details.Length>125)details=details[..125].Trim()+"…";index++;
    <article data-service-category="@ServiceCategories.For(item.Title)" class="luxe-service-card" data-aos="fade-up" data-aos-delay="@((index%3)*80)"><div class="luxe-service-media"><a asp-controller="Service" asp-action="ServiceDetails" asp-route-id="@item.Id"><img src="@Media.ServiceImage(item.Title,item.Image,item.Id)" alt="@item.Title" width="1200" height="830" loading="lazy" /></a><span class="luxe-service-index">@index.ToString("00")</span><span class="luxe-icon-box"><i class="fa-solid fa-@icon" aria-hidden="true"></i></span></div><div class="luxe-service-body"><h3><a asp-controller="Service" asp-action="ServiceDetails" asp-route-id="@item.Id">@item.Title</a></h3><p>@details</p><div class="luxe-service-meta"><span>@item.Content</span><a asp-controller="Service" asp-action="ServiceDetails" asp-route-id="@item.Id">@(en?"Discover":"Keşfedin") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></div></article>
}
