<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
@model BusinessLayer.Dtos.AdminDashboardDto
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "XSPA Yönetim Özeti"; }
<section class="xspa-dashboard"><header><span>XSPA · İŞLETME ÖZETİ</span><h1>Bugünün ritmi</h1><p>Türkiye saatine göre güncel randevu ve hizmet görünümü.</p></header>
<div class="card p-4 my-4"><h2 class="h5">Bu ay tahmini hizmet bedeli</h2><strong>@Model.EstimatedMonthlyRevenue.ToString("N2") ₺</strong><p>Onaylı randevular × güncel hizmet tarifesi. Tahsilat veya muhasebe raporu değildir.</p><span>@Model.Customers farklı müşteri · @Model.Guests toplam misafir</span></div>
@if(Model.Pending > 0){<a class="alert alert-warning d-flex justify-content-between align-items-center" asp-controller="AdminAppointment" asp-action="Index" asp-route-status="Pending"><strong>@Model.Pending Adet Yeni Randevu Onay Bekliyor</strong><span>İncelemek için tıklayın →</span></a>}
<div class="dashboard-metrics">
<article><span>Bugünkü Randevu</span><strong>@Model.Today</strong><small>@(Model.Today-Model.Yesterday >= 0 ? "↑" : "↓") Düne göre @(Model.Today-Model.Yesterday)</small></article>
<article><span>Onay Bekleyenler</span><strong>@Model.Pending</strong><small>● Güncel onay kuyruğu</small></article>
<article><span>Toplam Misafir</span><strong>@Model.Guests</strong><small>@Model.Customers farklı müşteri</small></article>
<article><span>Aktif Hizmetler</span><strong>@Model.ActiveServices</strong><small>● Randevuya açık</small></article>
</div>
<section class="card p-4 my-4"><h2 class="h5">Son 14 Gün · Randevu Trendi</h2><div class="dashboard-chart"><canvas id="appointment-trend" role="img" aria-label="Son 14 günün randevu sayıları"></canvas></div><details><summary>Grafik verilerini görüntüle</summary><ul>@foreach(var day in Model.Trend){<li>@day.Date: @day.Count</li>}</ul></details></section>
<script type="application/json" id="appointment-trend-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend))</script>
<section class="card p-4 my-4"><h2 class="h5">Popüler Hizmetler</h2>@if(Model.Distribution.Count == 0){<p>İlk randevu ile hizmet dağılımı oluşacak.</p>}else{<div class="dashboard-chart"><canvas id="service-distribution" role="img" aria-label="İptal edilmeyen randevuların hizmet dağılımı"></canvas></div><details><summary>Dağılım verilerini görüntüle</summary><ul>@foreach(var item in Model.Distribution){<li>@item.Service: @item.Count</li>}</ul></details>}<small>İptal edilmeyen randevular · En popüler 8 hizmet</small></section>
<script type="application/json" id="service-distribution-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Distribution))</script>
<section class="card p-4 my-4"><div class="d-flex justify-content-between"><h2 class="h5">Son Randevular</h2><a asp-controller="AdminAppointment" asp-action="Index">Tümünü Gör →</a></div><div class="dashboard-table"><table><thead><tr><th scope="col">Kod</th><th scope="col">Misafir</th><th scope="col">Hizmet / Tarih</th><th scope="col">Durum</th><th scope="col">İşlem</th></tr></thead><tbody>
@foreach(var item in Model.Recent){<tr><td>@item.ReferenceCode</td><td>@item.FullName<br /><small>@item.GuestCount misafir</small></td><td>@item.ServiceTitle<br /><small>@item.AppointmentDate.ToString("dd.MM.yyyy") · @item.TimeSlot</small></td><td><span class="dashboard-status @item.Status">@(item.Status == EntityLayer.Enum.AppointmentStatus.Pending ? "Onay Bekliyor" : item.Status == EntityLayer.Enum.AppointmentStatus.Confirmed ? "Onaylandı" : "İptal")</span></td><td>@if(item.Status == EntityLayer.Enum.AppointmentStatus.Pending){<form asp-controller="AdminAppointment" asp-action="Approve" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-success" type="submit">Onayla</button></form>}@if(item.Status != EntityLayer.Enum.AppointmentStatus.Cancelled){<form asp-controller="AdminAppointment" asp-action="Cancel" method="post" class="mt-2"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">İptal Et</button></form>}</td></tr>}
@if(Model.Recent.Count == 0){<tr><td colspan="5">Henüz randevu kaydı bulunmuyor.</td></tr>}
</tbody></table></div></section>
<!-- system-health -->
</section>

@section Scripts {
<script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>
<script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
