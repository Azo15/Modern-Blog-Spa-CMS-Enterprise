@model Slider

@{
    ViewData["Title"] = "Slider Güncelleme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" asp-action="Edit">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <!-- Görsel -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label"></label>
                        <input type="file" name="NewImageFile" class="form-control" accept="image/*" onchange="previewImage(this)" />
                        <small class="text-muted">Yeni bir görsel yüklemezseniz mevcut görsel kullanılacaktır.</small>
                        <div class="mt-2">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img id="imagePreview" src="~/@Model.Image" class="img-fluid" style="max-height: 200px; border-radius: 5px;" alt="Görsel Önizleme" />
                            }
                            else
                            {
                                <img id="imagePreview" src="~/img/default-image.jpg" class="img-fluid" style="max-height: 200px; border-radius: 5px;" alt="Görsel Önizleme" />
                            }
                        </div>
                    </div>
                </div>

                <div class="mb-3 col-lg-6">
                    <div class="form-group">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-group">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" id="tinymce"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Geri Dön
                    </a>
                    <button type="submit" class="btn btn-success">Güncelle</button>
                </div>
            </div>
        </form>
    </div>
</div>
