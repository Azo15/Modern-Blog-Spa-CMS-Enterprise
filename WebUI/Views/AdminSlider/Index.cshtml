@model IEnumerable<Slider>

@{
    ViewData["Title"] = L["Slider Listesi"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int sayac = 1;
}

<div class="card">
    <div class="justify-content-between d-flex align-items-center px-4">
        <h5 class="card-header">@ViewData["Title"]</h5>
        <a asp-action="Create" class="btn btn-outline-primary"><i class="fa-solid fa-plus me-md-2"></i>Slider Ekle</a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>
                        @Html.DisplayNameFor(model => model.Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Content)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Image)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UpdatedDate)
                    </th>
                    <th>@L["Eylemler"]</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {

                    <tr>
                        <td>
                            @sayac
                        </td>

                        <td>
                            @item.Title
                        </td>

                        <td>
                            @Html.Raw(item.Content)
                        </td>

                        <td>
                            <img src="~/@item.Image" alt="slider fotoğrafı" class="table-image" />
                        </td>

                        <td>
                            @(item.UpdatedDate?.ToString("dd MMMM yyyy") ?? "-")
                        </td>

                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-warning" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> @L["Düzenle"]
                                    </a>
                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-trash me-1"></i> @L["Sil"]
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    sayac++;
                }
            </tbody>
        </table>
        <hr class="mt-0" />
        <div class="px-5">
            <p><small>Tabloda</small><span class="mx-2">@ViewBag.Count</span><small>adet slider var</small></p>
        </div>
    </div>
</div>