@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Şifremi Unuttum"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<section class="xspa-auth-card auth-recovery" aria-labelledby="recovery-title">
    <span class="auth-eyebrow">XSPA · PRIVATE WELLNESS</span>
    <h1 id="recovery-title">Yeniden hoş geldiniz.</h1>
    <p>Hesabınızın e-posta adresini yazın. Parolanızı yenilemeniz için size güvenli bir bağlantı iletelim.</p>
    @if (TempData["ResetNotice"] is string notice)
    { <p class="auth-success" role="status">@notice</p><p class="auth-recovery-note">Gelen kutunuzu ve spam klasörünüzü kontrol edin. Bağlantı bir saat geçerlidir. E-posta ulaşmadıysa daha sonra yeniden deneyebilirsiniz.</p> }
    @if (TempData["ResetError"] is string error)
    { <p class="auth-error" role="alert">@error</p> }
    <p class="auth-recovery-note">@ForgotPasswordViewModel.GoogleAccountHelp</p>
    <form asp-controller="Dashboard" asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <label asp-for="Email">E-posta</label>
        <input asp-for="Email" type="email" class="form-control" autocomplete="email" maxlength="254" required aria-describedby="email-error" />
        <span asp-validation-for="Email" id="email-error"></span>
        <button type="submit" class="auth-submit">Sıfırlama bağlantısı gönder <span aria-hidden="true">→</span></button>
    </form>
    @await Html.PartialAsync("_GoogleSignIn")
    <a asp-controller="Dashboard" asp-action="SignIn" class="auth-home">← Giriş ekranına dön</a>
</section>
