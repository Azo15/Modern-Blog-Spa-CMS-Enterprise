@model ResetPasswordViewModel
@{ ViewData["Title"] = "Parolanızı Yenileyin"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<section class="xspa-auth-card auth-recovery" aria-labelledby="reset-title">
    <span class="auth-eyebrow">XSPA · PRIVATE WELLNESS</span>
    <h1 id="reset-title">Yeni bir başlangıç.</h1>
    <p>Hesabınız için yeni bir parola belirleyin. Bu bağlantı bir kez kullanılabilir.</p>
    <form asp-controller="Dashboard" asp-action="ResetPassword" method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <label asp-for="Password">Yeni parola</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" minlength="6" maxlength="128" required aria-describedby="password-help password-error" />
        <small id="password-help" class="auth-recovery-note">En az 6 karakter kullanın. Başka hesaplarda kullanmadığınız bir parola seçin.</small>
        <span asp-validation-for="Password" id="password-error"></span>
        <label asp-for="ConfirmPassword">Yeni parola tekrarı</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="6" maxlength="128" required aria-describedby="confirm-error" />
        <span asp-validation-for="ConfirmPassword" id="confirm-error"></span>
        <button type="submit" class="auth-submit">Parolamı yenile <span aria-hidden="true">→</span></button>
    </form>
    <a asp-controller="Dashboard" asp-action="ForgotPassword" class="auth-home">Yeni sıfırlama bağlantısı iste</a>
    <a asp-controller="Dashboard" asp-action="SignIn" class="auth-home">← Giriş ekranına dön</a>
</section>
