@model SignInViewModel

@{
    ViewData["Title"] = "Giriþ Yap";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<!-- Geri Sayým Overlay -->
<!-- Geri Sayým Overlay - Modernize edilmiþ -->
<div id="lockOverlay" style="display: none; position: fixed; z-index: 9999; top: 0; left: 0; width: 100%; height: 100%; background-color: #ff000085; backdrop-filter: blur(4px);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; background: white; padding: 40px; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
        <!-- Modern Spinner -->
        <div class="modern-spinner">
            <div class="spinner-ring"></div>
            <div class="spinner-ring"></div>
            <div class="spinner-ring"></div>
            <div class="spinner-ring"></div>
        </div>

        <!-- Büyük Saniye Gösterimi -->
        <div class="countdown-container">
            <p class="modelErrorText">Þifre ve ya e-posta adresiniz hatalý</p>
            <div class="countdown-number" id="countdownText">0</div>
            <div class="countdown-label">saniye sonra tekrar deneyebilirsiniz</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4" style="max-width: 500px; width: 100%;">
        <h3 class="text-center mb-4">Giriþ Yap</h3>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" id="loginForm">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <input type="email" asp-for="Email" class="form-control" placeholder="E-posta adresiniz" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="mb-3 position-relative">
                <input type="password" asp-for="Password" class="form-control" id="passwordInput" placeholder="Þifreniz" />
                <i class="fa fa-eye password-toggle cursor-pointer" onclick="togglePassword('passwordInput', this)"></i>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="RememberMe">Beni hatýrla</label>
                </div>
            </div>

            <button type="submit" id="loginBtn" class="btn btn-primary w-100">Giriþ Yap</button>
        </form>
    </div>
</div>

@section Scripts {
    @if (TempData["RemainingSeconds"] != null)
    {
        <text>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    let remaining = parseInt('@Html.Raw(TempData["RemainingSeconds"])');

                    const overlay = document.getElementById("lockOverlay");
                    const countdownText = document.getElementById("countdownText");
                    const loginBtn = document.getElementById("loginBtn");
                    const formInputs = document.querySelectorAll("#loginForm input");
                    const formLinks = document.querySelectorAll("a");

                    loginBtn.disabled = true;
                    formInputs.forEach(input => input.disabled = true);
                    formLinks.forEach(link => {
                        link.style.pointerEvents = "none";
                        link.style.opacity = "0.5";
                    });

                    overlay.style.display = "block";

                    const interval = setInterval(() => {
                        countdownText.innerText = remaining;

                        if (remaining <= 0) {
                            clearInterval(interval);
                            overlay.style.display = "none";

                            loginBtn.disabled = false;
                            formInputs.forEach(input => input.disabled = false);
                            formLinks.forEach(link => {
                                link.style.pointerEvents = "auto";
                                link.style.opacity = "1";
                            });
                        }

                        remaining--;
                    }, 1000);
                });
            </script>
        </text>
    }
}
