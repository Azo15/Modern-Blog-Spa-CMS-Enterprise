@model SignInViewModel
@{ ViewData["Title"] = L["Login"]; Layout = "~/Views/Shared/_LoginLayout.cshtml"; var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US"; }
<section class="xspa-auth-card"><span class="auth-eyebrow">XSPA · PRIVATE WELLNESS</span><nav class="auth-tabs" aria-label="@(en ? "Account" : "Hesap")"><a href="/dashboard/giris" aria-current="page">@(en ? "Sign In" : "Giriş Yap")</a><a href="/dashboard/kayit">@(en ? "Register" : "Kayıt Ol")</a></nav>
<h1>@(en ? "Welcome back." : "Kendinize hoş geldiniz.")</h1><p>@(en ? "Your rituals and favourites, all in one place." : "Ritüelleriniz ve favorileriniz, size özel bir yerde.")</p>
@if(TempData["AccountSuccess"] is string success){<p class="auth-success" role="status">@success</p>}
@if(TempData["ErrorMessage"] is string error){<p role="alert">@error</p>}
<form method="post" id="loginForm"><div asp-validation-summary="All" role="alert"></div><input type="hidden" name="returnUrl" value="@Context.Request.Query["ReturnUrl"]" />
<label asp-for="Email">@L["Email"]</label><input asp-for="Email" type="email" class="form-control" autocomplete="username" required /><span asp-validation-for="Email"></span>
<label asp-for="Password">@L["Password"]</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required /><span asp-validation-for="Password"></span>
<label class="auth-check"><input asp-for="RememberMe" /> @L["RememberMe"]</label><button type="submit" id="loginBtn" class="auth-submit">@(en ? "Sign In" : "Giriş Yap") →</button>
@if(TempData["RemainingSeconds"] is int seconds){<p class="auth-wait" role="status">@(en ? "Please wait before trying again:" : "Yeniden denemeden önce bekleyin:") <span id="auth-wait" data-seconds="@seconds">@seconds</span> @(en ? "seconds" : "saniye")</p>}
</form>@await Html.PartialAsync("_GoogleSignIn")<a class="auth-home" href="/">← @(en ? "Return to XSPA" : "XSPA’ya dön")</a></section>
@section Scripts {
<script>
const wait=document.getElementById('auth-wait');if(wait){let seconds=Number(wait.dataset.seconds);const button=document.getElementById('loginBtn');button.disabled=seconds>0;const timer=setInterval(()=>{seconds=Math.max(0,seconds-1);wait.textContent=String(seconds);if(seconds===0){clearInterval(timer);button.disabled=false;}},1000);}
</script>
}
