@model GenericDeleteViewModel
@{
    ViewData["Title"] = L["Delete"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white"><i class="fas fa-trash-alt me-2"></i>@L["Delete"] — @Model.EntityName</h5>
        </div>

        <div class="card-body">
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-circle fa-lg me-2"></i>
                <div>
                    @L["DeleteConfirmation"]
                </div>
            </div>

            <div class="row g-4 align-items-center">
                <div class="col-md-7">
                    <small class="col-sm-3 mb-2">@L["Title"]:</small>
                    <p class="col-sm-9 fw-bold">@Model.Title</p>

                    <small class="col-sm-3 mb-2">@L["Açıklama"]:</small>
                    <p class="col-sm-9 fw-bold">@Model.SubHeading</p>

                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <small class="col-sm-3 mb-2">@L["Content"]:</small>
                        <p class="col-sm-9 fw-bold">
                            @(Model.Content.Length > 200 ? Model.Content.Substring(0, 200) + "..." : Model.Content)
                        </p>
                    }

                </div>

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="col-md-5 text-center">
                        <img src="~/@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded shadow" style="max-height: 240px;" />
                    </div>
                }

                <div class="col-md-5 text-center">
                    @if (!string.IsNullOrEmpty(Model.Icon))
                    {
                        <i class="@Model.Icon fa-5x"></i>
                    }
                </div>
            </div>

            <form asp-action="DeleteConfirmed" method="post" class="mt-4">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> @L["Geri Dön"]
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i> @L[Model.EntityName == "Blog" ? "MoveTrash" : "Delete"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
