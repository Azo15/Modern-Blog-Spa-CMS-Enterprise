<!DOCTYPE html>

<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">

<head>
    @await Html.PartialAsync("/Views/LayoutPartial/_Header.cshtml")
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="animated-bg"></div>

    @await Component.InvokeAsync("_Navbar")

    @RenderBody()

    @await Component.InvokeAsync("_Footer")

    @await Html.PartialAsync("/Views/LayoutPartial/_Script.cshtml")

    @RenderSection("Scripts", required: false)
</body>
</html>
