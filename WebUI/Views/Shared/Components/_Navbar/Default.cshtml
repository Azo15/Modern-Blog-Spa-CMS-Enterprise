@model SiteTable
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService NavigationAuthorization
@{
    var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var accountName = User.Identity?.Name ?? (en ? "My account" : "Hesabım");
    string? panelController = null;
    if (signedIn)
    {
        if ((await NavigationAuthorization.AuthorizeAsync(User, BusinessLayer.Security.AccessPolicies.ContentManager)).Succeeded)
            panelController = "AdminDashboard";
    }
}
<header class="luxe-header" id="site-header">
    <aside class="xspa-announcement" id="xspa-announcement" hidden aria-label="@(en ? "Announcement" : "Duyuru")"><div class="container"><span>✦ @(en ? "Every day 09:00–00:00 · Make time for your wellbeing" : "Her gün 09:00–00:00 · İyi yaşamınıza zaman ayırın")</span><a href="/randevu">@(en ? "Book Online" : "Online Randevu Alın") →</a><button type="button" id="announcement-close" aria-label="@(en ? "Dismiss announcement" : "Duyuruyu kapat")">×</button></div></aside>
    <div class="luxe-topbar"><div class="container"><span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Kırklareli <span class="luxe-topbar-divider">/</span> @(en ? "A moment, just for you." : "Kendinize ayırdığınız bir an.")</span><a href="tel:+905388787000"><i class="fa-solid fa-phone" aria-hidden="true"></i> +90 538 878 70 00</a></div></div>
    <nav class="navbar navbar-expand-xl luxe-nav" aria-label="@(en ? "Main navigation" : "Ana menü")">
        <div class="container">
            <a class="luxe-brand" asp-controller="Default" asp-action="Index" aria-label="XSPA — @L["Home"]"><img src="~/img/brand-mark.svg" width="50" height="50" alt="" /><span>XSPA<small>SPA &amp; WELLNESS</small></span></a>
            <div class="luxe-nav-account">
                @if (signedIn)
                {
                    <div class="dropdown luxe-account-dropdown">
                        <button id="navbar-account" class="luxe-account luxe-account-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@(en ? $"Account menu for {accountName}" : $"{accountName} için hesap menüsü")">
                            <i class="fa-regular fa-user" aria-hidden="true"></i>
                            <span class="luxe-account-label">@accountName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end luxe-account-menu" aria-labelledby="navbar-account">
                            <li><span class="luxe-account-name">@accountName</span></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fa-regular fa-user" aria-hidden="true"></i>@L["Profile"]</a></li>
                            @if (panelController is not null)
                            {
                                <li><a class="dropdown-item luxe-admin-link" asp-controller="@panelController" asp-action="@(panelController == "AdminUserList" ? "UserList" : "Index")"><i class="fa-solid fa-sliders" aria-hidden="true"></i>Panel</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Dashboard" asp-action="Logout" method="post" class="luxe-account-logout">
                                    <button class="dropdown-item" type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>@(en ? "Sign out" : "Çıkış Yap")</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="luxe-account luxe-account-signin" asp-controller="Dashboard" asp-action="SignIn"><i class="fa-regular fa-user" aria-hidden="true"></i><span>@(en ? "Sign in" : "Giriş Yap")</span></a>
                }
            </div>
            <button class="luxe-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="@(en ? "Toggle menu" : "Menüyü aç veya kapat")"><span></span><span></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link @Html.IsActive("Default", "Index")" asp-controller="Default" asp-action="Index">@L["Home"]</a></li>
                    <li class="nav-item"><a class="nav-link @Html.IsActive("About", "Index")" asp-controller="About" asp-action="Index">@L["About"]</a></li>
                    <li class="nav-item"><a class="nav-link @Html.IsActive("Service", "Index")" asp-controller="Service" asp-action="Index">@L["Services"]</a></li>
                    <li class="nav-item"><a class="nav-link @Html.IsActive("Blog")" asp-controller="Blog" asp-action="Index">@L["Blog"]</a></li>
                    <li class="nav-item"><a class="nav-link @Html.IsActive("Galary", "Index")" asp-controller="Galary" asp-action="Index">@L["Gallery"]</a></li>
                    <li class="nav-item"><a class="nav-link @Html.IsActive("Contact", "Index")" asp-controller="Contact" asp-action="Index">@L["Contact"]</a></li>
                </ul>
                <div class="luxe-nav-actions">
                    @await Html.PartialAsync("_LanguageSelector")
                    <button id="theme-toggle" class="luxe-theme-toggle" type="button" aria-pressed="false" aria-label="@(en ? "Switch to dark theme" : "Koyu temaya geç")"><i class="fa-regular fa-moon" aria-hidden="true"></i><span class="visually-hidden">@(en ? "Change theme" : "Temayı değiştir")</span></button>
                    <button class="luxe-button luxe-button-gold luxe-nav-book" type="button" data-bs-toggle="modal" data-bs-target="#vip-reservation">@(en ? "Book a ritual" : "VIP Randevu")<i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    </nav>
</header>
