@model BlogInteractionViewModel
@using BusinessLayer
@using EntityLayer.Enum
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Text
<section class="luxe-interaction" aria-label="@Text["Interaction"]">
    @if (TempData["InteractionSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["InteractionError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div class="d-flex flex-wrap gap-2 align-items-center">
    @if (Model.CanInteract)
    {
        <form asp-controller="BlogInteraction" asp-action="Favorite" method="post" class="d-inline">
            <input type="hidden" name="blogId" value="@Model.BlogId" /><input type="hidden" name="slug" value="@Model.Slug" />
            <button type="submit" class="btn @(Model.Interaction.IsFavorite ? "btn-warning" : "btn-outline-secondary")" aria-pressed="@(Model.Interaction.IsFavorite ? "true" : "false")">@(Model.Interaction.IsFavorite ? Text["RemoveFavorite"] : Text["Favorite"])</button>
        </form>
        @foreach (var reaction in Enum.GetValues<ReactionType>())
        {
            var count = reaction switch { ReactionType.Like => Model.Interaction.LikeCount, ReactionType.Heart => Model.Interaction.HeartCount, _ => Model.Interaction.ClapCount };
            <form asp-controller="BlogInteraction" asp-action="Reaction" method="post" class="d-inline">
                <input type="hidden" name="blogId" value="@Model.BlogId" /><input type="hidden" name="slug" value="@Model.Slug" /><input type="hidden" name="reactionType" value="@((int)reaction)" />
                <button type="submit" class="btn @(Model.Interaction.Reaction == reaction ? "btn-primary" : "btn-outline-primary")" aria-pressed="@(Model.Interaction.Reaction == reaction ? "true" : "false")">@Text[reaction.ToString()] (@count)</button>
            </form>
        }
    }
    else
    {
        <span>@Text["Like"]: @Model.Interaction.LikeCount · @Text["Heart"]: @Model.Interaction.HeartCount · @Text["Clap"]: @Model.Interaction.ClapCount</span>
        <span class="text-muted">@(User.Identity?.IsAuthenticated == true ? Text["AccountDisabled"] : Text["LoginToInteract"])</span>
    }
    </div>
</section>
