@model FooterViewModel
@{var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US"; var mail = Model.Contact?.Mail; var socials = new[] { ("https://instagram.com/xspawellness","instagram"), ("https://facebook.com/xspawellness","facebook-f"), ("https://youtube.com/@xspawellness","youtube"), ("https://twitter.com/xspawellness","twitter") };}
<section class="luxe-booking-band"><div class="container"><div><span class="luxe-eyebrow">@(en ? "YOUR NEXT CHAPTER OF CALM" : "DİNGİNLİĞE İLK ADIM")</span><h2>@(en ? "Make time for yourself." : "Bugün, kendinize zaman ayırın.")</h2></div><button type="button" class="luxe-button luxe-button-outline" data-bs-toggle="modal" data-bs-target="#vip-reservation">@(en ? "Plan your visit" : "Deneyiminizi planlayın") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div></section>
<footer class="luxe-footer"><div class="container">
    <div class="luxe-footer-grid">
        <div class="luxe-footer-story"><a class="luxe-brand" asp-controller="Default" asp-action="Index"><img src="~/img/brand-mark.svg" width="58" height="58" alt="" /><span>XSPA<small>SPA &amp; WELLNESS</small></span></a><p>@(en ? "A quiet invitation to pause. Thoughtful rituals, natural textures and a little more room to simply be." : "Yavaşlamaya zarif bir davet. Özenli ritüeller, doğal dokular ve sadece kendiniz olabileceğiniz bir alan.")</p><div class="luxe-socials">@foreach(var (url,icon) in socials){if(Uri.TryCreate(url,UriKind.Absolute,out var uri) && uri.Scheme=="https"){<a href="@uri" target="_blank" rel="noopener noreferrer" aria-label="@icon"><i class="fa-brands fa-@icon" aria-hidden="true"></i></a>}}</div></div>
        <div><h3>@(en ? "Explore" : "Keşfedin")</h3><a asp-controller="About" asp-action="Index">@L["About"]</a><a asp-controller="Service" asp-action="Index">@L["Services"]</a><a asp-controller="Galary" asp-action="Index">@L["Gallery"]</a><a asp-controller="Blog" asp-action="Index">@(en ? "Wellbeing journal" : "İyi yaşam günlüğü")</a><a asp-controller="Contact" asp-action="Index">@L["Contact"]</a></div>
        <div><h3>@(en ? "Stay in touch" : "Birlikte planlayalım")</h3><a class="luxe-footer-phone" href="tel:+905388787000">+90 538 878 70 00</a>@if(!string.IsNullOrWhiteSpace(mail)){<a href="mailto:@mail">@mail</a>}<p>@Model.Contact?.Adres</p><p><i class="fa-regular fa-clock" aria-hidden="true"></i> @(en ? "Every day" : "Her gün") · @BusinessDisplayInfo.OpeningHours <span class="luxe-business-status" data-business-status role="status" aria-live="polite"></span></p><a href="https://wa.me/905388787000" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> @(en ? "WhatsApp appointments" : "WhatsApp randevu hattı")</a></div>
        <div class="luxe-footer-news"><h3>@(en ? "A note of wellbeing" : "İyi yaşamdan bir not")</h3><p>@(en ? "Receive a curated selection of our published wellbeing articles." : "Yayımlanan iyi yaşam yazılarından seçkiler için ilginizi paylaşın.")</p><form asp-controller="Contact" asp-action="NewsletterInterest" method="post" data-newsletter-form><label class="visually-hidden" for="newsletter-email">@L["Email"]</label><div class="luxe-newsletter-field"><input id="newsletter-email" type="email" name="email" maxlength="254" required placeholder="@(en ? "Your email address" : "E-posta adresiniz")" autocomplete="email" /><button type="submit" aria-label="@(en ? "Request updates" : "Bülten ilgisi gönder")"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div><small data-newsletter-status role="status" aria-live="polite">@(en ? "Your email is used for your newsletter request." : "E-posta adresiniz bülten talebiniz için kullanılır.")</small></form></div>
    </div>
    <div class="luxe-footer-bottom"><span>© @DateTime.UtcNow.Year XSPA. @L["AllRightsReserved"]</span><span>SPA · WELLNESS · SLOW LIVING</span><a href="#main-content">@(en ? "Back to top" : "Yukarı dön") <i class="fa-solid fa-arrow-up" aria-hidden="true"></i></a></div>
</div></footer>
