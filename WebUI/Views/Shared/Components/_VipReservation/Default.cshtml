@model VipReservationViewModel
@using BusinessLayer.ValidationRules
@{ var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US"; }
<div class="modal fade luxe-vip" id="vip-reservation" tabindex="-1" aria-labelledby="vip-title" aria-describedby="vip-intro" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="luxe-vip-header">
            <span class="luxe-eyebrow">XSPA · PRIVATE RESERVATIONS</span>
            <button class="luxe-modal-close" type="button" data-bs-dismiss="modal" aria-label="@(en ? "Close" : "Kapat")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            <h2 id="vip-title">@(en ? "Your online reservation." : "Size özel online rezervasyon.")</h2>
            <p id="vip-intro">@(en ? "Choose your ritual and send your appointment request. Our team will contact you to confirm availability." : "Ritüelinizi seçin, randevu talebinizi iletin. Ekibimiz uygunluğu teyit etmek için sizinle iletişime geçsin.")</p>
        </div>
        @if (Model.Services.Count > 0)
        {
            <form id="vip-form" class="luxe-vip-form" action="/randevu" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClientRequestId" id="vip-request-id" />
                <div class="modal-body">
                    <ol class="luxe-vip-progress" aria-label="@(en ? "Reservation steps" : "Rezervasyon adımları")">
                        <li data-vip-progress="0" aria-current="step"><span>01</span>@(en ? "Your ritual" : "Ritüeliniz")</li>
                        <li data-vip-progress="1"><span>02</span>@(en ? "Your time" : "Zamanınız")</li>
                        <li data-vip-progress="2"><span>03</span>@(en ? "Your details" : "Bilgileriniz")</li>
                    </ol>
                    <fieldset data-vip-step="0">
                        <legend tabindex="-1">@(en ? "Which ritual speaks to you?" : "Hangi ritüel size iyi gelir?")</legend>
                        <div class="luxe-vip-services">
                            @foreach (var service in Model.Services)
                            {
                                <label class="luxe-vip-service">
                                    <input type="radio" name="ServiceId" value="@service.Id" data-service-title="@service.Title" required />
                                    <span class="luxe-vip-choice"><img src="@service.ImageUrl" alt="" width="400" height="240" loading="lazy" /><span>@service.Title<i class="fa-solid fa-check" aria-hidden="true"></i></span></span>
                                </label>
                            }
                        </div>
                    </fieldset>
                    <fieldset data-vip-step="1" hidden>
                        <legend tabindex="-1">@(en ? "Make room for yourself." : "Kendinize zaman ayırın.")</legend>
                        <div class="luxe-vip-fields">
                            <div><label for="vip-date">@(en ? "Preferred date" : "Tercih ettiğiniz gün")</label><input id="vip-date" name="AppointmentDate" type="date" class="form-control" required /></div>
                            <div><label for="vip-time">@(en ? "Preferred time" : "Tercih ettiğiniz saat")</label><select id="vip-time" name="TimeSlot" class="form-select" required><option value="">@(en ? "Select a time" : "Saat seçin")</option>@foreach(var slot in AppointmentSchedule.TimeSlots){<option value="@slot">@slot</option>}</select></div>
                            <div><label for="vip-guests">@(en ? "Guests" : "Misafir sayısı")</label><select id="vip-guests" name="GuestCount" class="form-select" required>@for(var count=1;count<=4;count++){<option value="@count">@count @(en ? "guest(s)" : "kişi")</option>}</select></div>
                        </div>
                        <p class="luxe-vip-note"><i class="fa-regular fa-clock" aria-hidden="true"></i>@(en ? "Every day · 09:00–00:00 · Türkiye time. Reservations up to 90 days ahead." : "Haftanın her günü · 09:00–00:00 · Türkiye saati. Önümüzdeki 90 gün için talep oluşturabilirsiniz.")</p>
                    </fieldset>
                    <fieldset data-vip-step="2" hidden>
                        <legend tabindex="-1">@(en ? "Let us welcome you." : "Sizi tanımak isteriz.")</legend>
                        <div class="luxe-vip-fields">
                            <div><label for="vip-name">@(en ? "Full name" : "Adınız ve soyadınız")</label><input id="vip-name" name="FullName" class="form-control" autocomplete="name" minlength="2" maxlength="120" required /></div>
                            <div><label for="vip-phone">@(en ? "Phone number" : "Telefon numaranız")</label><input id="vip-phone" name="Phone" class="form-control" type="tel" inputmode="tel" autocomplete="tel" placeholder="+90 5xx xxx xx xx" pattern="\+?[0-9 \(\)\-]{10,29}" maxlength="30" required /></div>
                            <div class="full-width"><label for="vip-email">@(en ? "Email address" : "E-posta adresiniz")</label><input id="vip-email" name="Email" class="form-control" type="email" autocomplete="email" maxlength="254" required /></div>
                            <div class="full-width"><label for="vip-notes">@(en ? "Special requests or allergies (optional)" : "Özel istek veya alerji notunuz (isteğe bağlı)")</label><textarea id="vip-notes" name="Notes" class="form-control" maxlength="2000" rows="3"></textarea></div>
                        </div>
                        <div class="luxe-vip-summary" aria-live="polite"></div>
                        <p class="luxe-vip-note">@(en ? "Your details and notes are used by our team to plan your appointment. A received request is subject to availability confirmation." : "Bilgileriniz ve notlarınız, ekibimizin randevunuzu planlaması için kullanılır. Talebinizin ardından uygunluk teyidi yapılır.")</p>
                    </fieldset>
                    <p class="luxe-vip-error" role="alert" hidden></p>
                    <section class="luxe-reservation-receipt" data-booking-success role="status" tabindex="-1" hidden>
                        <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
                        <span class="luxe-eyebrow">@(en ? "YOUR REQUEST HAS BEEN RECEIVED" : "RANDEVU TALEBİNİZ ALINDI")</span>
                        <h3>@(en ? "A little calm is on its way." : "Dinginliğe bir adım daha.")</h3>
                        <p>@(en ? "Your reservation reference" : "Rezervasyon kodunuz")</p>
                        <strong data-booking-reference></strong>
                        <p>@(en ? "Your appointment request was received successfully. We will contact you for confirmation." : "Randevu talebiniz başarıyla alındı, onay için sizinle iletişime geçilecektir.")</p>
                        <button class="luxe-button luxe-button-gold" type="button" data-bs-dismiss="modal">@(en ? "Lovely" : "Harika")<i class="fa-solid fa-check" aria-hidden="true"></i></button>
                    </section>
                    <noscript><p><a asp-controller="Contact" asp-action="Index">@(en ? "Contact us to arrange your appointment." : "Randevunuzu planlamak için bize ulaşın.")</a></p></noscript>
                </div>
                <div class="luxe-vip-actions">
                    <button class="luxe-vip-back" type="button" data-vip-back hidden><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>@(en ? "Back" : "Geri")</button>
                    <button class="luxe-button luxe-button-gold" type="button" data-vip-next>@(en ? "Continue" : "Devam edin")<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    <button class="luxe-button luxe-button-gold" type="submit" data-vip-submit hidden>@(en ? "Confirm request" : "Randevuyu onayla")<i class="fa-regular fa-calendar-check" aria-hidden="true"></i></button>
                </div>
            </form>
        }
        else
        {
            <div class="modal-body"><p>@(en ? "Contact our team to plan your appointment." : "Randevunuzu planlamak için ekibimizle iletişime geçin.")</p><a class="luxe-button luxe-button-gold" href="tel:+905388787000">+90 538 878 70 00</a></div>
        }
        <div class="luxe-booking-support">@(en ? "Urgent questions?" : "Acil sorularınız için:") <a href="https://wa.me/905388787000" target="_blank" rel="noopener noreferrer">WhatsApp @(en ? "Concierge" : "Danışma Hattı")</a></div>
    </div></div>
</div>
