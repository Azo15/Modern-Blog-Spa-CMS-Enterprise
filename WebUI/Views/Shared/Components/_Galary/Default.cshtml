@model List<Galary>


<section class="section section-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="section-title font-playfair" data-aos="fade-up">Galeri</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Spa merkezimizden görüntüler
                </p>
            </div>
        </div>

        @await Html.PartialAsync("~/Views/Galary/_GalleryCardPartial.cshtml", Model)

        <div class="text-center mt-4" data-aos="fade-up" data-aos-delay="200">
            <a class="btn btn-primary-custom" asp-controller="Galary" asp-action="Index">
                Tüm Galeriyi Görüntüle
            </a>
        </div>
    </div>
</section>