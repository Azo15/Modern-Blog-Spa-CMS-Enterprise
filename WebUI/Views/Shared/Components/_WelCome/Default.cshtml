@model List<Slider>

@if (Model != null && Model.Any())
{
    <section class="hero-section">
        <div class="swiper hero-swiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model)
                {
                    var imageUrl = Url.Content($"/{item.Image}");
                    <div class="swiper-slide hero-slide"
                         style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('@imageUrl');">
                        <div class="container my-auto">
                            <div class="row">
                                <div class="col-lg-8 mx-auto">
                                    <div class="hero-content" data-aos="fade-up">
                                        <h1 class="hero-title font-playfair">@item.Title</h1>
                                        <p class="hero-subtitle">@Html.Raw(SafeHtml.Sanitize(item.Content))</p>
                                        <div class="mt-4">
                                            <a class="btn btn-primary-custom me-3" asp-controller="Service" asp-action="Index">Hizmetlerimizi Keşfedin</a>
                                            <a class="btn btn-outline-custom" asp-controller="Contact" asp-action="Index">Bize Ulaş</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Count > 1)
            {
                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            }
        </div>
    </section>
}
