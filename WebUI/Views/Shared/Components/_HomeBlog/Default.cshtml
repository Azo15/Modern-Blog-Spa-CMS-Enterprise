@model IEnumerable<BusinessLayer.Dtos.BlogListDto>
@{var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US";}
<section class="luxe-section luxe-section-dark"><div class="container">
    <div class="luxe-section-heading" data-aos="fade-up"><div><span class="luxe-eyebrow">@(en ? "THE WELLBEING JOURNAL" : "İYİ YAŞAM GÜNLÜĞÜ")</span><h2>@(en ? "Small rituals." : "Küçük ritüeller.")<br /><em>@(en ? "Meaningful moments." : "Güzel değişimler.")</em></h2></div><div class="luxe-section-intro"><p>@(en ? "A little inspiration for bringing care, balance and mindfulness into your everyday." : "Bakımı, dengeyi ve farkındalığı günlük hayatınıza taşımak için bir tutam ilham.")</p><a class="luxe-text-link" asp-controller="Blog" asp-action="Index">@(en ? "Read the journal" : "Günlüğü keşfedin") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></div>
    <div class="luxe-blog-grid">@await Html.PartialAsync("/Views/Blog/_BlogCardPartial.cshtml", Model.Take(3))</div>
    @if(!Model.Any()){<p>@(en ? "Our next wellbeing story is being prepared." : "Bir sonraki iyi yaşam hikâyemiz hazırlanıyor.")</p>}
</div></section>
