@model WebUI.Models.SidebarGroupModel
<section class="sidebar-group"><button type="button" class="sidebar-group-title" aria-expanded="true" aria-controls="sidebar-@Model.Id"><i class="fa-solid @Model.Icon" aria-hidden="true"></i><span>@Model.Title</span><span class="sidebar-chevron" aria-hidden="true">⌄</span></button><div class="sidebar-group-panel" id="sidebar-@Model.Id"><div>@foreach(var link in Model.Links){<a asp-controller="@link.Controller" asp-action="@link.Action" asp-route-ai="@(link.Ai ? "1" : null)" class="menu-link">@link.Label</a>}</div></div></section>
