<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" class="layout-menu-fixed layout-compact" data-assets-path="~/assets/"
      data-template="vertical-menu-template-free">

<head>
    @await Html.PartialAsync("_AjaxSecurity")
    @await Html.PartialAsync("~/Views/Admin/_Head.cshtml")
    @await RenderSectionAsync("Styles", required: false)
<link rel="stylesheet" href="~/css/admin-sidebar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/interactions.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/notification-bell.css" asp-append-version="true" />
</head>

<body class="xspa-admin">
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            @await Html.PartialAsync("~/Views/Admin/_Sidebar.cshtml")

            <div class="layout-page">

                @await Component.InvokeAsync("_TopHeader")
                <div class="px-4 pt-2 text-end">@await Html.PartialAsync("_LanguageSelector")</div>

                <div class="content-wrapper px-xxl-5">
                    <div class="container-fluid flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>

                    @await Html.PartialAsync("~/Views/Admin/_Taos.cshtml")
                    @await Html.PartialAsync("~/Views/Admin/_Footer.cshtml")

                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>

        <div class="layout-overlay layout-menu-toggle"></div>
    </div>


    @await Html.PartialAsync("~/Views/Admin/_Script.cshtml")

    <script src="~/js/notification-bell.js" asp-append-version="true"></script>
    <script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
<script src="~/js/interactions.js" asp-append-version="true"></script>
</body>

</html>
