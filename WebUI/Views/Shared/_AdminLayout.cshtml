<!DOCTYPE html>
<html lang="tr" class="layout-menu-fixed layout-compact" data-assets-path="~/assets/"
      data-template="vertical-menu-template-free">

<head>
    @await Html.PartialAsync("~/Views/Admin/_Head.cshtml")
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            @await Html.PartialAsync("~/Views/Admin/_Sidebar.cshtml")

            <div class="layout-page">

                @await Component.InvokeAsync("_TopHeader")

                <div class="content-wrapper px-xxl-5">
                    <div class="container-fluid flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>

                    @await Html.PartialAsync("~/Views/Admin/_Taos.cshtml")
                    @await Html.PartialAsync("~/Views/Admin/_Footer.cshtml")

                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>

        <div class="layout-overlay layout-menu-toggle"></div>
    </div>


    @await Html.PartialAsync("~/Views/Admin/_Script.cshtml")

    @RenderSection("Scripts", required: false)
</body>

</html>