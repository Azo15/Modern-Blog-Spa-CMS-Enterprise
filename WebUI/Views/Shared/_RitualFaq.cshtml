@model string
@{
    var en = System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US";
    var prefix = string.Concat((Model ?? "ritual").Where(char.IsLetterOrDigit));
    if (string.IsNullOrEmpty(prefix)) prefix = "ritual";
    var accordionId = $"{prefix}-faq";
    var questions = new[]
    {
        (
            Question: en ? "How do you prepare for a hygienic visit?" : "Hijyen ve hazırlık hakkında ne bilmeliyim?",
            Answer: en
                ? "Please follow the therapist’s preparation instructions and use the towels and slippers provided. Contact our team before arrival about suitability or preparation; do not submit sensitive health details through website forms."
                : "Terapistinizin hazırlık yönlendirmelerine uyun; sağlanan havlu ve terlikleri kullanın. Hizmete uygunluk ve hazırlık sorularınızı ziyaret öncesinde ekibimize sorun; internet formlarından hassas sağlık bilgisi göndermeyin."
        ),
        (
            Question: en ? "How early should I arrive?" : "Randevuya kaç dakika önce gelmeliyim?",
            Answer: en
                ? "We recommend arriving 15 minutes before your appointment, so we can welcome you, discuss your preferences and prepare for your ritual at an unhurried pace."
                : "Sizi karşılamak, tercihlerinizi birlikte değerlendirmek ve ritüelinize sakince hazırlanmak için randevunuzdan 15 dakika önce gelmenizi öneririz."
        ),
        (
            Question: en ? "What should I bring?" : "Yanımda ne getirmeliyim?",
            Answer: en
                ? "We provide a peshtemal, slippers and towels. Contact our team directly for preparation and suitability questions. Do not enter sensitive health information in online forms."
                : "Peştamal, terlik ve havlu tarafımızdan sağlanır. Hazırlık ve uygunluk sorularınız için ekibimize doğrudan ulaşın. Online formlara hassas sağlık bilgisi yazmayın."
        ),
        (
            Question: en ? "How can I cancel or reschedule?" : "İptal ve erteleme şartları nelerdir?",
            Answer: en
                ? "To cancel or reschedule, please contact our team as early as possible on +90 538 878 70 00 and share your reservation reference. We will explain the applicable conditions and help you find another available time."
                : "İptal veya erteleme için lütfen mümkün olan en erken zamanda +90 538 878 70 00 üzerinden ekibimizle iletişime geçip rezervasyon kodunuzu paylaşın. Talebinize ait koşulları ve uygun alternatif saatleri birlikte değerlendirelim."
        )
    };
}
<section class="luxe-section luxe-faq" aria-labelledby="@(accordionId)-title">
    <div class="container">
        <div class="luxe-faq-heading">
            <span class="luxe-eyebrow">@(en ? "BEFORE YOUR VISIT" : "ZİYARETİNİZDEN ÖNCE")</span>
            <h2 id="@(accordionId)-title">@(en ? "A little peace of mind." : "Aklınızdaki küçük sorular.")</h2>
            <p>@(en ? "A few details to help you feel at ease before your ritual begins." : "Ritüelinize başlamadan önce kendinizi rahat hissetmeniz için birkaç küçük ayrıntı.")</p>
        </div>
        <div class="accordion luxe-faq-accordion" id="@accordionId">
            @for (var i = 0; i < questions.Length; i++)
            {
                var headingId = $"{accordionId}-question-{i}";
                var panelId = $"{accordionId}-answer-{i}";
                <div class="accordion-item">
                    <h3 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#@panelId" aria-expanded="false" aria-controls="@panelId">
                            <span class="luxe-faq-number" aria-hidden="true">@((i + 1).ToString("00"))</span>
                            @questions[i].Question
                        </button>
                    </h3>
                    <div id="@panelId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#@accordionId">
                        <div class="accordion-body">@questions[i].Answer</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
