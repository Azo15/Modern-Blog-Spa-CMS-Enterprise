@model WebUI.Models.ExternalRegistrationModel
@{Layout="~/Views/Shared/_LoginLayout.cshtml";ViewData["Title"]="Google Kaydını Tamamla";}
<section class="xspa-auth-card"><h1>Bir adım kaldı.</h1><p>@ViewBag.GoogleEmail adresi Google tarafından doğrulandı.</p><form asp-action="Register" method="post"><div asp-validation-summary="All"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="FirstName">Ad</label><input asp-for="FirstName" class="form-control" /><label asp-for="LastName">Soyad</label><input asp-for="LastName" class="form-control" /><label asp-for="Phone">Telefon</label><input asp-for="Phone" type="tel" class="form-control" /><label class="auth-check"><input asp-for="KvkkAccepted" required /><a href="/kvkk" target="_blank" rel="noopener noreferrer">KVKK aydınlatma metnini okudum.</a></label><button class="auth-submit" type="submit">Müşteri Hesabımı Oluştur</button></form></section>
