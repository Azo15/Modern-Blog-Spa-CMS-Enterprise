@{ViewData["Title"]=L["Home"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
@await Component.InvokeAsync("_WelCome")
@await Component.InvokeAsync("_HomeService")
<section class="luxe-section"><div class="container luxe-story"><div class="luxe-story-media" data-aos="fade-up"><img src="~/img/about-retreat.webp" width="1200" height="1200" loading="lazy" alt="@(en ? "Quiet waters and natural spa textures" : "Dingin su ve doğal spa dokuları")" /></div><div class="luxe-story-text" data-aos="fade-up"><span class="luxe-eyebrow">@(en ? "THE XSPA PHILOSOPHY" : "XSPA FELSEFESİ")</span><h2>@(en ? "Less hurry." : "Biraz yavaşlayın.")<br /><em>@(en ? "More you." : "Biraz kendinize dönün.")</em></h2><p>@(en ? "We believe wellbeing begins when you make room for yourself. A gentle touch, the scent of nature, the quiet warmth of water. Every detail invites you to be present." : "İyi yaşamın, kendinize alan açtığınız anda başladığına inanıyoruz. Zarif bir dokunuş, doğanın kokusu, suyun sessiz sıcaklığı. Her detay sizi o anın içinde olmaya davet ediyor.")</p><div class="luxe-signature">@(en ? "Your moment. Your balance." : "Sizin anınız. Sizin dengeniz.")</div><a class="luxe-text-link" asp-controller="About" asp-action="Index">@(en ? "Our story" : "Hikâyemizi keşfedin") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></div></section>
@await Component.InvokeAsync("_HomeBlog")
<partial name="_GuestExperiences" />
@await Component.InvokeAsync("_Galary")
