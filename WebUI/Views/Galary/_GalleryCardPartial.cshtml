@model IEnumerable<Galary>
@{var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";var items=Model.ToList();var names=new[]{en?"A quiet treatment":"Dingin bir dokunuş",en?"Warmth & nature":"Sıcaklık ve doğa",en?"A moment of water":"Suya ayrılan bir an",en?"Tea & stillness":"Çay ve sessizlik",en?"Hydrotherapy":"Hidroterapi",en?"A private ritual":"Özel bir ritüel",en?"Shared wellbeing":"Birlikte iyi yaşam",en?"A softer pace":"Daha sakin bir ritim"};}
<div class="luxe-gallery-grid">@if(items.Count>0){@foreach(var item in items){var image=Media.GalleryImage(item.Title,item.Image,item.Id);<a class="luxe-gallery-item" href="@image" data-fancybox="spa-gallery" data-caption="@System.Net.WebUtility.HtmlEncode(item.Title ?? "")" data-aos="fade-up"><img src="@image" alt="@item.Title" width="1200" height="1333" loading="lazy" /><span>@item.Title</span><i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i></a>}}else{@for(var i=0;i<8;i++){<a class="luxe-gallery-item" href="/img/gallery-@(i+1).webp" data-fancybox="spa-gallery" data-caption="@names[i]"><img src="/img/gallery-@(i+1).webp" alt="@names[i]" width="1200" height="1333" loading="lazy" /><span>@names[i]</span><i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i></a>}}</div>
