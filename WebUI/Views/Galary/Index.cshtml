@model List<Galary>
@{ViewData["Title"]=L["Gallery"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
<section class="luxe-page-hero"><div class="container"><span class="luxe-eyebrow">@(en?"THE ATMOSPHERE":"ATMOSFERİ KEŞFEDİN")</span><h1 class="luxe-title">@(en?"A quieter world,":"Daha sakin bir dünya,")<br /><em>@(en?"in every detail.":"her bir detayda.")</em></h1><p class="luxe-lead">@(en?"A curated glimpse of the spa world. Warmth, texture and moments of calm.":"Spa dünyasından özenle seçilmiş kareler. Sıcaklık, dokular ve dingin anlar.")</p><span class="luxe-page-number">03 / ATMOSPHERE</span></div></section><section class="luxe-section"><div class="container">@await Html.PartialAsync("_GalleryCardPartial",Model)<p class="luxe-gallery-caption">@(en?"Illustrative spa photography. Select an image to explore.":"Spa atmosferini yansıtan görseller. Yakından keşfetmek için bir kare seçin.")</p></div></section>
