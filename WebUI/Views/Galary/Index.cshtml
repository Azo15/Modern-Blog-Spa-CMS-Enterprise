@model List<Galary>
@{ViewData["Title"]=L["Gallery"];var en=System.Globalization.CultureInfo.CurrentUICulture.Name=="en-US";}
<section class="luxe-page-hero luxe-gallery-hero"><div class="container"><span class="luxe-eyebrow">@(en?"THE ATMOSPHERE":"ATMOSFERİ KEŞFEDİN")</span><h1 class="luxe-title">@(en?"A quieter world,":"Daha sakin bir dünya,")<br /><em>@(en?"in every detail.":"her bir detayda.")</em></h1><p class="luxe-lead">@(en?"A curated glimpse of the spa world. Warmth, texture and moments of calm.":"Spa dünyasından özenle seçilmiş kareler. Sıcaklık, dokular ve dingin anlar.")</p><span class="luxe-page-number">03 / ATMOSPHERE</span></div></section><section class="luxe-section luxe-gallery-section"><div class="container"><div class="luxe-gallery-filters" data-gallery-filters role="group" aria-label="@(en ? "Gallery categories" : "Galeri kategorileri")" hidden>@foreach (var filter in new[] { ("all", en ? "All" : "Tümü"), ("mekan", en ? "Spaces" : "Mekan"), ("ritueller", en ? "Rituals" : "Ritüeller"), ("urunler", en ? "Products" : "Ürünler"), ("ekip", en ? "Team" : "Ekip") }) { <button type="button" data-gallery-filter="@filter.Item1" aria-pressed="@(filter.Item1 == "all" ? "true" : "false")">@filter.Item2</button> }</div><p data-gallery-count class="luxe-search-status" role="status" aria-live="polite"></p>@await Html.PartialAsync("_GalleryCardPartial",Model)<p data-gallery-empty class="luxe-empty" hidden>@(en ? "No photographs in this category yet." : "Bu kategoride henüz fotoğraf yok.")</p><p class="luxe-gallery-caption">@(en?"Illustrative spa photography. Select an image to explore.":"Spa atmosferini yansıtan görseller. Yakından keşfetmek için bir kare seçin.")</p></div></section>
