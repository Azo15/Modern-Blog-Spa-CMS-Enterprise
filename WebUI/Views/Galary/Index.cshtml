@model List<Galary>
@{
    ViewData["Title"] = "Galeri";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}
@{
    int delay = 100;
    int delayIncrement = 100;
}
<div id="gallery" >
    <section class="section section-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="section-title font-playfair" data-aos="fade-up">Galeri</h1>
                    <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                        Spa merkezimizden görüntüler ve atmosfer
                    </p>
                </div>
            </div>

            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-3 col-md-6 mb-3" data-aos="fade-up" data-aos-delay="@delay">
                        <a href="/@item.Image" class="gallery-item" data-fancybox="gallery" data-caption="@item.Title">
                            <img src="/@item.Image" alt="Spa Görseli">
                            <div class="gallery-overlay">
                                <p class="d-block">@item.Title</p>
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </a>
                    </div>
                    delay += delayIncrement;
                }
            </div>
        </div>
    </section>
</div>