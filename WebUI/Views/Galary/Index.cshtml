@model List<Galary>
@{
    ViewData["Title"] = "Galeri";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<div id="gallery" >
    <section class="section section-light">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="section-title font-playfair" data-aos="fade-up">Galeri</h1>
                    <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                        Spa merkezimizden görüntüler ve atmosfer
                    </p>
                </div>
            </div>

            @await Html.PartialAsync("_GalleryCardPartial", Model)
        </div>
    </section>
</div>