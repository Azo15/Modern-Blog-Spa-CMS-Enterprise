@model BusinessLayer.Dtos.PaginatedList<BusinessLayer.Dtos.BlogAdminDto>
@{
    ViewData["Title"] = L["Trash"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="card p-4">
    <h5>@L["Trash"]</h5>
    <p>@L["TrashGuidance"]</p>
    <a asp-action="Index">@L["Back"]</a>
    <table class="table"><thead><tr><th>@L["Title"]</th><th>@L["DeletedDateUtc"]</th><th>@L["DeletedBy"]</th><th>@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var blog in Model.Items)
    {
        <tr><td>@blog.Title</td><td>@blog.DeletedDate</td><td>@blog.DeletedBy</td><td>
            <form asp-action="Restore" method="post">
                <input type="hidden" name="id" value="@blog.Id" />
                <button class="btn btn-success" type="submit">@L["Restore"]</button>
            </form>
        </td></tr>
    }
    </tbody></table>
</div>

<nav>
@if(Model.HasPreviousPage){<a asp-action="Trash" asp-route-page="@(Model.PageIndex-1)">@L["Previous"]</a>}
<span>@L["Page"] @Model.PageIndex / @Math.Max(1,Model.TotalPages)</span>
@if(Model.HasNextPage){<a asp-action="Trash" asp-route-page="@(Model.PageIndex+1)">@L["Next"]</a>}
</nav>
