@using BusinessLayer.Security
@using EntityLayer.Enum
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@model BusinessLayer.Dtos.PaginatedList<BusinessLayer.Dtos.BlogAdminDto>

@{
    ViewData["Title"] = L["BlogList"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int sayac = 1;
    var canReview = (await Authorization.AuthorizeAsync(User, AccessPolicies.ContentManager)).Succeeded;
    var canReport = (await Authorization.AuthorizeAsync(User, AccessPolicies.Admin)).Succeeded;
}

<div class="mb-4"><button type="button" class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#ai-blog-modal"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> AI ile Blog Yazısı Üret</button></div>
<div class="card">
    @if (canReport)
    {
        <div class="d-flex flex-wrap gap-2 p-3">
            <a asp-controller="Reports" asp-action="Blogs" asp-route-format="Excel" class="btn btn-outline-success">@L["Blog"] — @L["ExportExcel"]</a>
            <a asp-controller="Reports" asp-action="Blogs" asp-route-format="Pdf" class="btn btn-outline-danger">@L["Blog"] — @L["ExportPdf"]</a>
            <a asp-controller="Reports" asp-action="Interactions" asp-route-format="Excel" class="btn btn-outline-success">@L["Interaction"] — @L["ExportExcel"]</a>
            <a asp-controller="Reports" asp-action="Interactions" asp-route-format="Pdf" class="btn btn-outline-danger">@L["Interaction"] — @L["ExportPdf"]</a>
        </div>
    }
    <div class="justify-content-between d-flex align-items-center px-4">
        <h5 class="card-header">@ViewData["Title"]</h5>

        <form asp-action="Index" method="get" class="p-4">

            @Html.AntiForgeryToken()

            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <label for="categoryId" class="col-form-label">@L["Category"]:</label>
                </div>
                <div class="col-auto">
                    <select name="categoryId" id="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">@L["All"]</option>
                        @if (ViewBag.Categories is List<SelectListItem> categoryList)
                        {
                            foreach (var cat in categoryList)
                            {
                                <option value="@cat.Value" selected="@(ViewBag.SelectedCategory?.ToString() == cat.Value ? "selected" : null)">
                                    @cat.Text
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
        </form>

        @if (canReview) { <a asp-action="Trash" class="btn btn-outline-secondary">@L["Trash"]</a> }
        <a asp-action="Create" class="btn btn-outline-primary"><i class="fa-solid fa-plus me-md-2"></i>@L["CreateBlog"]</a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>
                        @L["Title"]
                    </th>
                    <th>
                        @L["Content"]
                    </th>
                    <th>
                        @L["Image"]
                    </th>
                    <th>
                        @L["Updated"]
                    </th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model.Items)
                {

                    <tr>
                        <td>
                            @sayac
                            <div class="small">@L[item.PublishStatus.ToString()]</div>
                            <form asp-action="SubmitForReview" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">@L["SubmitReview"]</button>
                            </form>
                            @if (canReview)
                            {
                                <form asp-action="Review" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button name="status" value="Published" class="btn btn-sm btn-success">@L["Publish"]</button>
                                    <button name="status" value="Rejected" class="btn btn-sm btn-danger">@L["Reject"]</button>
                                    <button name="status" value="Draft" class="btn btn-sm btn-secondary">@L["MoveDraft"]</button>
                                </form>
                            }
                        </td>

                        <td>
                            @item.Title
                        </td>

                        <td style="font-size:0.85rem; line-height: 1.4;">
                            @{
                                var plain = System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", "");
                                var decoded = System.Web.HttpUtility.HtmlDecode(plain);
                                var preview = decoded.Length > 150 ? decoded.Substring(0, 150) + "..." : decoded;
                            }
                            @preview
                        </td>

                        <td>
                            @{
                                var imgPath = string.IsNullOrEmpty(item.Image) ? "img/default-image.jpg" : item.Image;
                            }
                            <img src="~/@imgPath"
                                 alt="blog görseli"
                                 class="table-image" />
                        </td>

                        <td>
                            @(item.UpdatedDate?.ToString("dd MMMM yyyy") ?? "-")
                        </td>

                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-warning" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>@L["Edit"]
                                    </a>
                                    <a class="dropdown-item text-danger"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id">
                                        <i class="fa-solid fa-trash me-1"></i>@L["Delete"]
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    sayac++;
                }
            </tbody>
        </table>
        <hr class="mt-0" />
        <div class="px-5">
            <p><small>Tabloda</small><span class="mx-2">@ViewBag.blogCount</span><small>adet veri var</small></p>
        </div>
    </div>
</div>
<nav class="p-3" aria-label="Blog sayfaları">
@if (Model.HasPreviousPage) { <a asp-action="Index" asp-route-page="@(Model.PageIndex-1)" asp-route-categoryId="@ViewBag.SelectedCategory">@L["Previous"]</a> }
<span>@L["Page"] @Model.PageIndex / @Math.Max(1,Model.TotalPages)</span>
@if (Model.HasNextPage) { <a asp-action="Index" asp-route-page="@(Model.PageIndex+1)" asp-route-categoryId="@ViewBag.SelectedCategory">@L["Next"]</a> }
</nav>

@await Html.PartialAsync("_AiBlogModal")

@section Scripts {<script src="~/js/ai-blog.js" asp-append-version="true"></script>}
