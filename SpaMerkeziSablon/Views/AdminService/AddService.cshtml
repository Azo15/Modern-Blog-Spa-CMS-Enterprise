@model SpaMerkeziSablon.Models.AddService

@{
    ViewData["Title"] = "Hizmet Ekleme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Hizmet Ekle</h1>

<form method="post" enctype="multipart/form-data" action="AddService">
    <div class="form-group">
        @Html.Label("Hizmet Adı")
        <input type="text" asp-for="ServiceName" class="form-control" />
    </div>
    <br />
    <div class="form-group">
        @Html.Label("Hizmet Aıklaması")
        <input type="text" asp-for="ServiceDescription" class="form-control" />
    </div>
    <br />

    <div class="form-group">
        @Html.Label("Detaylı hizmet açıklaması")
        <input type="text" asp-for="ServiceDetails" class="form-control" />
    </div>
    <br />

    <div class="form-group">
        <label>Resim Seçiniz</label>
        <input type="file" asp-for="ImgUrl" />
    </div>

    <br />
    <br />
    <br />

    <button class="btn btn-outline-warning mt-2 mb-5" onclick="alert('Hizmet oluturuldu');">Hizmeti Olustur</button>
    <br />

</form>