@model IEnumerable<Galary>
@{
    Layout = null;
    int j = 0;
}

<div class="col-12 bg-dark pt-4 pb-4 d-flex">
    <span class="text-white mx-auto"> Galeri</span>
</div>
<div class="row galary w-100 justify-content-center m-auto">
    @foreach (var item in Model)
    {
            <div class="col-lg-4 col-md-12 mb-4 mb-lg-0">
                <img style="height:300px" src="/galary/@item.GalaryImg"
                     class="w-100 shadow-1-strong rounded-3 mb-4"
                     alt="Boat on Calm Water" />
            </div>
        j++;
        if (j == 12)
        {
            break;
        }
    }

</div>
<a href="/Galary/Index" class="btn btn-danger p-3 mb-4 px-lg-5 mx-auto d-table">Galeriye Git</a>

