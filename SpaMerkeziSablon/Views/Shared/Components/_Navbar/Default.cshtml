
@model IEnumerable<Home>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark p-4">
    <a class="navbar-brand" href="/Default/Index/">WELLNESS SPA</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mx-auto justify-content-center">
            <li class="nav-item">
                @foreach (var link in Model)
                {
                    <a class="nav-link btn btn-danger" href="@link.BannerUrl" target="_blank">
                        <span data-feather="shopping-cart"></span>
                        Günlük Kiralık Ev
                    </a>
                }
            </li>
            <li class="nav-item active">
                <a class="nav-link" href="/Default/Index/">Ana Sayfa<span class="sr-only">(current)</span></a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="~/About/Index/">Hakkımızda</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Service/Index/">Hizmetlerimiz</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Contact/Index/">İletişim</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Galary/Index/">Galeri</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Blog/Index/">Blog</a>
            </li>
        </ul>
    </div>
    @foreach (var item in Model)
    {
        <a href="https://www.instagram.com/@item.instagramURl/">
            <img class="icon" src="/icon/insta.ico" alt="instagram" />
        </a>
    }
</nav>