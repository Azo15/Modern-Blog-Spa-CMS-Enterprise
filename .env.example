# Copy to .env. Supply different random values; never commit .env.
# SQL passwords: 16-128 characters, upper/lower case + number + symbol.
# Double quotes, semicolons and newlines are unsupported in these passwords.
MSSQL_SA_PASSWORD=
MSSQL_MIGRATOR_PASSWORD=
MSSQL_APP_PASSWORD=

# JWT signing key: at least 32 bytes, random. Keep stable between deployments.
JWT_SIGNING_KEY=
JWT_ISSUER=modern-blog-platform
JWT_AUDIENCE=modern-blog-clients
JWT_ACCESS_TOKEN_MINUTES=30

# Optional first System Admin; skipped when a System Admin already exists.
# Password: at least 14 characters with upper/lower/digit/symbol.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Loopback ports avoid exposing SQL/Redis/the admin UI to the network.
WEBUI_HOST_PORT=5158
MSSQL_HOST_PORT=1433
REDIS_HOST_PORT=6379

# Developer is for development/demo only. Choose a licensed edition in production.
MSSQL_PID=Developer

# Explicit local HTTP demo option. Set false for HTTPS production deployment.
LOCAL_HTTP=true
SWAGGER_ENABLED=false

# SMTP is optional at startup; persisted messages/jobs survive delivery outages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_RECIPIENT_EMAIL=

# Public contact form requires valid CAPTCHA settings; startup does not.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=
